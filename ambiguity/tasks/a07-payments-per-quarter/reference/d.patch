+package com.acme.backoffice.service;
+
+import com.acme.backoffice.DataStore;
+import com.acme.backoffice.model.QuarterPayments;
+
+import java.util.List;
+
+/** The number of payments received per quarter of a year, overall and per region. */
+public class QuarterPaymentsService {
+    private final DataStore store;
+
+    public QuarterPaymentsService(DataStore store) {
+        this.store = store;
+    }
+
+    public List<QuarterPayments> report(int year) {
+        if (year < 1) {
+            throw new IllegalArgumentException("Year must be positive");
+        }
+        return store.findPaymentCountPerQuarter(year);
+    }
+}
