+
+    /**
+     * For each of the four quarters of the year, in order: the number of payments received in the quarter, in total and
+     * per region of the customer (payments of cancelled invoices are not counted). Quarters and regions without payments
+     * are included with zeros.
+     */
+    public List<QuarterPayments> findPaymentsPerQuarter(int year) {
+        String sql = "SELECT q.x AS quarter_no, "
+                + "(SELECT COUNT(*) FROM payment p JOIN invoice i ON i.id = p.invoice_id JOIN customer c ON c.id = i.customer_id WHERE YEAR(p.payment_date) = ? AND QUARTER(p.payment_date) = q.x AND i.status <> 'CANCELLED') AS total_count, "
+                + "(SELECT COUNT(*) FROM payment p JOIN invoice i ON i.id = p.invoice_id JOIN customer c ON c.id = i.customer_id WHERE YEAR(p.payment_date) = ? AND QUARTER(p.payment_date) = q.x AND i.status <> 'CANCELLED' AND c.region = 'NORTH') AS north_count, "
+                + "(SELECT COUNT(*) FROM payment p JOIN invoice i ON i.id = p.invoice_id JOIN customer c ON c.id = i.customer_id WHERE YEAR(p.payment_date) = ? AND QUARTER(p.payment_date) = q.x AND i.status <> 'CANCELLED' AND c.region = 'SOUTH') AS south_count, "
+                + "(SELECT COUNT(*) FROM payment p JOIN invoice i ON i.id = p.invoice_id JOIN customer c ON c.id = i.customer_id WHERE YEAR(p.payment_date) = ? AND QUARTER(p.payment_date) = q.x AND i.status <> 'CANCELLED' AND c.region = 'EAST') AS east_count, "
+                + "(SELECT COUNT(*) FROM payment p JOIN invoice i ON i.id = p.invoice_id JOIN customer c ON c.id = i.customer_id WHERE YEAR(p.payment_date) = ? AND QUARTER(p.payment_date) = q.x AND i.status <> 'CANCELLED' AND c.region = 'WEST') AS west_count "
+                + "FROM SYSTEM_RANGE(1, 4) q ORDER BY q.x";
+        try (PreparedStatement statement = connection.prepareStatement(sql)) {
+            for (int i = 1; i <= 5; i++) {
+                statement.setInt(i, year);
+            }
+            try (ResultSet rs = statement.executeQuery()) {
+                List<QuarterPayments> quarters = new ArrayList<>();
+                while (rs.next()) {
+                    Map<Region, Integer> perRegion = new EnumMap<>(Region.class);
+                    perRegion.put(Region.NORTH, rs.getInt("north_count"));
+                    perRegion.put(Region.SOUTH, rs.getInt("south_count"));
+                    perRegion.put(Region.EAST, rs.getInt("east_count"));
+                    perRegion.put(Region.WEST, rs.getInt("west_count"));
+                    quarters.add(new QuarterPayments(rs.getInt("quarter_no"), rs.getInt("total_count"), perRegion));
+                }
+                return quarters;
+            }
+        } catch (SQLException e) {
+            throw new IllegalStateException("Cannot find payments per quarter", e);
         }
     }
 
