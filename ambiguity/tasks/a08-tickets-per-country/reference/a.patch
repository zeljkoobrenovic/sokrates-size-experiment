+    /**
+     * The support tickets of the customers of the country opened between the two dates, inclusive, whatever their
+     * status, oldest first, then by id.
+     */
+    public List<SupportTicket> findSupportTicketsByCountry(String country, LocalDate from, LocalDate to) {
+        String sql = "SELECT t.id, t.number, t.customer_id, t.order_id, t.subject, t.priority, t.status, t.opened_date, t.closed_date "
+                + "FROM support_ticket t JOIN customer c ON c.id = t.customer_id "
+                + "WHERE c.country = ? AND t.opened_date >= ? AND t.opened_date <= ? "
+                + "ORDER BY t.opened_date, t.id";
+        try (PreparedStatement statement = connection.prepareStatement(sql)) {
+            statement.setString(1, country);
+            statement.setObject(2, from);
+            statement.setObject(3, to);
+            try (ResultSet rs = statement.executeQuery()) {
+                List<SupportTicket> tickets = new ArrayList<>();
+                while (rs.next()) {
+                    tickets.add(new SupportTicket(rs.getLong("id"), rs.getString("number"), rs.getLong("customer_id"),
+                            rs.getObject("order_id", Long.class), rs.getString("subject"),
+                            TicketPriority.valueOf(rs.getString("priority")), TicketStatus.valueOf(rs.getString("status")),
+                            rs.getObject("opened_date", LocalDate.class), rs.getObject("closed_date", LocalDate.class)));
+                }
+                return tickets;
+            }
+        } catch (SQLException e) {
+            throw new IllegalStateException("Cannot find support tickets by country", e);
+        }
+    }
+
+    /**
+     * The number of support tickets opened between the two dates, inclusive, by the customers of each country, whatever
+     * their status (countries without tickets in the period are left out). Sorted by ticket count, highest first, then
+     * by country.
+     */
+    public List<CountryTicketCount> findSupportTicketCountPerCountry(LocalDate from, LocalDate to) {
+        String sql = "SELECT c.country AS country, COUNT(*) AS ticket_count FROM support_ticket t "
+                + "JOIN customer c ON c.id = t.customer_id "
+                + "WHERE t.opened_date >= ? AND t.opened_date <= ? "
+                + "GROUP BY c.country ORDER BY ticket_count DESC, c.country";
+        try (PreparedStatement statement = connection.prepareStatement(sql)) {
+            statement.setObject(1, from);
+            statement.setObject(2, to);
+            try (ResultSet rs = statement.executeQuery()) {
+                List<CountryTicketCount> counts = new ArrayList<>();
+                while (rs.next()) {
+                    counts.add(new CountryTicketCount(rs.getString("country"), rs.getInt("ticket_count")));
+                }
+                return counts;
+            }
+        } catch (SQLException e) {
+            throw new IllegalStateException("Cannot find support ticket count per country", e);
+        }
+    }
