diff -ruN -x target -x .git a/src/main/java/com/acme/backoffice/service/CountryTicketsService.java b/src/main/java/com/acme/backoffice/service/CountryTicketsService.java
--- a/src/main/java/com/acme/backoffice/service/CountryTicketsService.java	1970-01-01 01:00:00
+++ b/src/main/java/com/acme/backoffice/service/CountryTicketsService.java	2026-10-16 07:54:57
@@ -0,0 +1,36 @@
+package com.acme.backoffice.service;
+
+import com.acme.backoffice.DataStore;
+import com.acme.backoffice.model.CountryTicketCount;
+import com.acme.backoffice.model.SupportTicket;
+
+import java.time.LocalDate;
+import java.util.List;
+
+/** The support tickets of the customers of a country opened between two dates, and the number of tickets per country. */
+public class CountryTicketsService {
+    private final DataStore store;
+
+    public CountryTicketsService(DataStore store) {
+        this.store = store;
+    }
+
+    public List<SupportTicket> tickets(String country, LocalDate from, LocalDate to) {
+        if (country == null || country.isBlank()) {
+            throw new IllegalArgumentException("Country is required");
+        }
+        checkRange(from, to);
+        return store.findSupportTicketsByCountry(country, from, to);
+    }
+
+    public List<CountryTicketCount> countPerCountry(LocalDate from, LocalDate to) {
+        checkRange(from, to);
+        return store.findSupportTicketCountPerCountry(from, to);
+    }
+
+    private void checkRange(LocalDate from, LocalDate to) {
+        if (from == null || to == null || to.isBefore(from)) {
+            throw new IllegalArgumentException("Invalid date range");
+        }
+    }
+}
