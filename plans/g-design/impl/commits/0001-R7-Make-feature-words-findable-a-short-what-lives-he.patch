@@ -58,6 +58,21 @@ import java.util.stream.Collectors;
 
 import static java.nio.charset.StandardCharsets.UTF_8;
 
+/**
+ * The Sokrates command-line entry point ({@code java -jar sokrates.jar <command> <options>}).
+ * <p>
+ * Synonyms not used in the code: CLI, main, sub-command, verb, argument parsing.
+ * <p>
+ * Command &rarr; handler (dispatched in {@link #run}): {@code init} &rarr; {@code init};
+ * {@code updateConfig} &rarr; {@code updateConfig}; {@code exportStandardConventions} &rarr; {@code exportConventions};
+ * {@code updateLandscape} &rarr; {@code updateLandscape}; {@code createConventionsFile} &rarr; {@code createNewConventionsFile};
+ * {@code extractGitSubHistory} &rarr; {@code extractGitSubHistory}; {@code extractFiles} &rarr; {@code extractFiles};
+ * {@code extractGitHistory} &rarr; {@code extractGitHistory}; {@code generateReports} &rarr; {@code generateReports};
+ * anything else prints the usage.
+ * <p>
+ * A new command also needs: name, description and options in {@link Commands}, and a line in
+ * {@code Commands.usageInfo()} (which currently does not list {@code extractFiles}).
+ */
 public class CommandLineInterface {
     public static final int THOUSAND_YEARS = 365 * 1000;
     private static final Log LOG = LogFactory.getLog(CommandLineInterface.class);
