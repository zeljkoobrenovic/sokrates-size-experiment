+        handlers.put(Commands.EXTRACT_FILES, this::extractFiles);
+        handlers.put(Commands.EXTRACT_GIT_HISTORY, this::extractGitHistory);
+        handlers.put(Commands.GENERATE_REPORTS, this::generateReports);
+        return handlers;
+    }
