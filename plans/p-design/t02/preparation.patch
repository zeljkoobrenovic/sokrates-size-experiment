+    // Naming of the per-extension entries (linesOfCodePerExtension, fileCountPerExtension in analysisResults.json,
+    // and the per-extension aspects below). Today an entry is named with a decorated label, "  *.java".
+    public static String perExtensionName(String extension) {
+        return decoratedExtensionLabel(extension);
+    }
+
+    // The decorated "  *.java" label (also used by the indented lines of the textual analysis summary).
+    public static String decoratedExtensionLabel(String extension) {
+        return "  *." + extension;
+    }
+
+    // The plain lower-cased extension of a per-extension entry name ("  *.java" -> "java"),
+    // used e.g. for the per-extension metric ids (LINES_OF_CODE_MAIN_EXT_JAVA, NUMBER_OF_FILES_MAIN_EXT_JAVA).
+    public static String extensionName(String perExtensionName) {
+        return perExtensionName == null ? "" : perExtensionName.replace("*.", "").trim().toLowerCase();
+    }
+
+    // The key under which a landscape merges/aggregates the per-extension lines-of-code entries of its repositories
+    // (main scope, and the merged "other" category: build and deployment, generated, other).
+    // Entries with the same key are merged into one entry.
+    public static String landscapeAggregationKey(String perExtensionName) {
+        return perExtensionName.toLowerCase();
+    }
+
+    // One aspect per (lower-cased) file extension, named by perExtensionName(extension), sorted by LOC desc.
