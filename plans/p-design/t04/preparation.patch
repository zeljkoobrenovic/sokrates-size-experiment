+    /**
+     * Test code conventions for mock resources: files under a mock-resources folder (a folder whose name
+     * starts with "mock" or "__mock", e.g. mocks/, __mocks__/, mock-data/, mockStore/) and files named *_mock.*.
+     * Patterns are matched against the whole path with "/" separators; Windows-style paths with backslashes
+     * are handled by SourceFileFilter.pathMatches, so the patterns here need only "/".
+     */
+    private void addMockResourcesConventions() {
+        testFilesConventions.add(new Convention(".*/mockapi/.*", "", "Mock resources"));
+        // mock-resources folders: the folder name starts with "__mock" or "mock"
+        testFilesConventions.add(new Convention(".*/__mock[a-zA-Z0-9_\\- ]+/.*", "", "Mock resources"));
+        testFilesConventions.add(new Convention(".*/mock[a-zA-Z0-9_\\- ]+/.*", "", "Mock resources"));
+        testFilesConventions.add(new Convention(".*_mock[.][a-zA-Z0-9_\\-]+", "", "Mock resources"));
+    }
+
     private void addIgnoreConventions() {
         ignoredFilesConventions.add(new Convention(".*/[.][a-zA-Z0-9_]+.*", "", "Hidden files and folders"));
         ignoredFilesConventions.add(new Convention(".*[.]resx", "", "The resx resource files"));
