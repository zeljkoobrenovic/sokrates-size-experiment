+    /**
+     * Adds the file count of one dependency from group "from" to group "to" to the existing group link
+     * (same direction, or the reverse direction of one already seen), or creates a new group link.
+     */
+    private void mergeIntoGroupLink(List<ComponentDependency> groupDependencies, Map<String, ComponentDependency> groupDependenciesMap,
+                                    String from, String to, int count) {
+        String key1 = from + "::" + to;
+        String key2 = to + "::" + from;
+
+        if (groupDependenciesMap.containsKey(key1)) {
+            groupDependenciesMap.get(key1).setCount(groupDependenciesMap.get(key1).getCount() + count);
+        } else if (groupDependenciesMap.containsKey(key2)) {
+            // reverse direction
+            groupDependenciesMap.get(key2).setCount(groupDependenciesMap.get(key1).getCount() + count);
+        } else {
+            ComponentDependency newDependency = new ComponentDependency(from, to);
+            newDependency.setCount(count);
+            groupDependencies.add(newDependency);
+            groupDependenciesMap.put(key1, newDependency);
+        }
+    }
