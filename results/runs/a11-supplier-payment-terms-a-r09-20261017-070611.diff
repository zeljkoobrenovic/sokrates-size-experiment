diff --git a/src/test/java/com/acme/backoffice/SupplierPaymentTermsTest.java b/src/test/java/com/acme/backoffice/SupplierPaymentTermsTest.java
new file mode 100644
index 0000000..a30e49b
--- /dev/null
+++ b/src/test/java/com/acme/backoffice/SupplierPaymentTermsTest.java
@@ -0,0 +1,32 @@
+package com.acme.backoffice;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+import com.acme.backoffice.model.Supplier;
+import org.junit.jupiter.api.Test;
+
+class SupplierPaymentTermsTest {
+
+    private final DataStore store = new DataStore(Database.openInMemory());
+
+    @Test
+    void defaultsToThirtyDays() {
+        Supplier created = store.createSupplier(new Supplier(0, "Nordic AB", "a@nordic.se", "Sweden", 4));
+        assertEquals(30, created.paymentTermsDays());
+        assertEquals(30, store.findSupplierById(created.id()).orElseThrow().paymentTermsDays());
+    }
+
+    @Test
+    void renegotiatedTermsShowInAllListings() {
+        Supplier created = store.createSupplier(new Supplier(0, "Nordic AB", "a@nordic.se", "Sweden", 4, 45));
+        assertEquals(45, created.paymentTermsDays());
+
+        store.updateSupplier(new Supplier(created.id(), created.name(), created.contactEmail(), created.country(),
+                created.rating(), 14));
+
+        assertEquals(14, store.findSupplierById(created.id()).orElseThrow().paymentTermsDays());
+        assertEquals(14, store.listSuppliersByName().get(0).paymentTermsDays());
+        assertEquals(14, store.listSuppliersByCountry("Sweden").get(0).paymentTermsDays());
+        assertEquals(14, store.listSuppliersByMinimumRating(4).get(0).paymentTermsDays());
+    }
+}
