diff --git a/src/test/java/com/acme/backoffice/SupplierTest.java b/src/test/java/com/acme/backoffice/SupplierTest.java
index 5136faa..a7b8b54 100644
--- a/src/test/java/com/acme/backoffice/SupplierTest.java
+++ b/src/test/java/com/acme/backoffice/SupplierTest.java
@@ -58,4 +58,16 @@ class SupplierTest {
         assertEquals(List.of("Charlie"), names(store.listSuppliersByMinimumRating(5)));
         assertEquals(3, store.listSuppliersByMinimumRating(1).size());
     }
+
+    @Test
+    void paymentTermsDefaultToThirtyDaysAndCanBeRenegotiated() {
+        Supplier registered = store.createSupplier(new Supplier(0, "Nordic", "n@example.com", "Sweden", 3, 45));
+        assertEquals(45, registered.paymentTermsDays());
+        assertEquals(30, store.createSupplier(new Supplier(0, "Plain", "p@example.com", "Sweden", 3)).paymentTermsDays());
+        store.updateSupplier(new Supplier(registered.id(), "Nordic", "n@example.com", "Sweden", 3, 14));
+        assertEquals(14, store.findSupplierById(registered.id()).orElseThrow().paymentTermsDays());
+        assertEquals(List.of(14, 30), store.listSuppliersByCountry("Sweden").stream().map(Supplier::paymentTermsDays).toList());
+        assertEquals(List.of(14, 30), store.listSuppliersByName().stream().map(Supplier::paymentTermsDays).toList());
+        assertEquals(List.of(14, 30), store.listSuppliersByMinimumRating(3).stream().map(Supplier::paymentTermsDays).toList());
+    }
 }
