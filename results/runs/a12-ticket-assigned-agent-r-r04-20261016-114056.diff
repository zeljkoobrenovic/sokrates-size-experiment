+    @Test
+    void assignedAgentIsShownAndKeptOnStatusChange() {
+        SupportTicket assigned = service.create("T-1", alpha.id(), null, "A", TicketPriority.HIGH, LocalDate.of(2024, 2, 1), " Sam ");
+        SupportTicket unassigned = service.create("T-2", alpha.id(), null, "B", TicketPriority.HIGH, LocalDate.of(2024, 2, 2), " ");
+        assertEquals("Sam", assigned.agent());
+        assertNull(unassigned.agent());
+        assertEquals("Sam", store.supportTickets().findByNumber("T-1").orElseThrow().agent());
+        assertEquals("Sam", service.listOpenByCustomer(alpha.id()).get(0).agent());
+
+        assertEquals("Sam", service.changeStatus("T-1", TicketStatus.IN_PROGRESS, LocalDate.of(2024, 2, 3)).agent());
+        assertEquals("Sam", service.changeStatus("T-1", TicketStatus.CLOSED, LocalDate.of(2024, 2, 4)).agent());
+        assertEquals("Sam", store.supportTickets().findByNumber("T-1").orElseThrow().agent());
+        assertNull(store.supportTickets().findByNumber("T-2").orElseThrow().agent());
+    }
