-/** A supplier with a rating from 1 to 5. The id is 0 until the supplier has been created in the database. */
-public record Supplier(long id, String name, String contactEmail, String country, int rating) {
+/**
+ * A supplier with a rating from 1 to 5 and the number of days after the invoice date within which we pay them. The id is
+ * 0 until the supplier has been created in the database.
+ */
+public record Supplier(long id, String name, String contactEmail, String country, int rating, int paymentTermsDays) {
+
+    /** The payment terms of a supplier for whom nothing was agreed. */
+    public static final int STANDARD_PAYMENT_TERMS_DAYS = 30;
+
+    public Supplier(long id, String name, String contactEmail, String country, int rating) {
+        this(id, name, contactEmail, country, rating, STANDARD_PAYMENT_TERMS_DAYS);
+    }
 }
