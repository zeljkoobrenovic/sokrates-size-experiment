+ */
+
+package nl.obren.sokrates.sourcecode.landscape.analysis;
+
+import nl.obren.sokrates.sourcecode.Metadata;
+import nl.obren.sokrates.sourcecode.analysis.results.CodeAnalysisResults;
+import nl.obren.sokrates.sourcecode.landscape.LandscapeConfiguration;
+import nl.obren.sokrates.sourcecode.metrics.NumericMetric;
+import org.junit.Test;
+
+import java.util.Arrays;
+import java.util.List;
+import java.util.stream.Collectors;
+
+import static org.junit.Assert.*;
+
+public class LandscapeAnalysisResultsTest {
+    @Test
+    public void getMainLinesOfCodePerExtensionMergesDecoratedAndBareNames() {
+        LandscapeAnalysisResults landscape = landscape(
+                repository("legacy", "  *.java", "  *.xml", 100),
+                repository("current", "java", "xml", 50));
+
+        List<NumericMetric> main = landscape.getMainLinesOfCodePerExtension();
+        assertEquals(1, main.size());
+        assertEquals("java", main.get(0).getName());
+        assertEquals(150, main.get(0).getValue().intValue());
+        assertEquals(Arrays.asList("legacy", "current"), names(main.get(0)));
+
+        List<NumericMetric> other = landscape.getOtherLinesOfCodePerExtension();
+        assertEquals(1, other.size());
+        assertEquals("xml", other.get(0).getName());
+        assertEquals(Arrays.asList("legacy", "current"), names(other.get(0)));
+    }
+
+    private LandscapeAnalysisResults landscape(RepositoryAnalysisResults... repositories) {
+        LandscapeAnalysisResults landscape = new LandscapeAnalysisResults(null, null);
+        landscape.setConfiguration(new LandscapeConfiguration());
+        landscape.setRepositoryAnalysisResults(Arrays.asList(repositories));
+        return landscape;
+    }
+
+    private RepositoryAnalysisResults repository(String name, String mainExtension, String otherExtension, int loc) {
+        CodeAnalysisResults results = new CodeAnalysisResults();
+        Metadata metadata = new Metadata();
+        metadata.setName(name);
+        results.setMetadata(metadata);
+        results.getMainAspectAnalysisResults().setLinesOfCode(loc);
+        results.getMainAspectAnalysisResults().getLinesOfCodePerExtension().add(new NumericMetric(mainExtension, loc));
+        results.getOtherAspectAnalysisResults().getLinesOfCodePerExtension().add(new NumericMetric(otherExtension, loc));
+        return new RepositoryAnalysisResults(null, results, null);
+    }
+
+    private List<String> names(NumericMetric metric) {
+        return metric.getDescription().stream().map(NumericMetric::getName).collect(Collectors.toList());
+    }
+}
