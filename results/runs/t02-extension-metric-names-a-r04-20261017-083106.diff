+package nl.obren.sokrates.sourcecode.landscape.analysis;
+
+import nl.obren.sokrates.sourcecode.Metadata;
+import nl.obren.sokrates.sourcecode.analysis.results.CodeAnalysisResults;
+import nl.obren.sokrates.sourcecode.metrics.NumericMetric;
+import org.junit.jupiter.api.Test;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+public class LandscapeAnalysisResultsTest {
+    @Test
+    public void mergesOldAndNewExtensionNames() {
+        LandscapeAnalysisResults landscape = new LandscapeAnalysisResults(null, null);
+        landscape.setRepositoryAnalysisResults(Arrays.asList(
+                repository("old", metrics("  *.java", 100, "  *.js", 10), metrics("  *.xml", 7), new ArrayList<>()),
+                repository("new", metrics("java", 50), new ArrayList<>(), metrics("xml", 3))));
+
+        List<NumericMetric> main = landscape.getMainLinesOfCodePerExtension();
+        assertEquals(2, main.size());
+        assertEquals("java", main.get(0).getName());
+        assertEquals(150, main.get(0).getValue().intValue());
+        assertEquals(2, main.get(0).getDescription().size());
+        assertEquals("old", main.get(0).getDescription().get(0).getName());
+        assertEquals("new", main.get(0).getDescription().get(1).getName());
+        assertEquals("js", main.get(1).getName());
+
+        List<NumericMetric> other = landscape.getOtherLinesOfCodePerExtension();
+        assertEquals(1, other.size());
+        assertEquals("xml", other.get(0).getName());
+        assertEquals(10, other.get(0).getValue().intValue());
+        assertEquals(2, other.get(0).getDescription().size());
+    }
+
+    private List<NumericMetric> metrics(Object... nameAndValues) {
+        List<NumericMetric> metrics = new ArrayList<>();
+        for (int i = 0; i < nameAndValues.length; i += 2) {
+            metrics.add(new NumericMetric((String) nameAndValues[i], (Integer) nameAndValues[i + 1]));
+        }
+        return metrics;
+    }
+
+    private RepositoryAnalysisResults repository(String name, List<NumericMetric> main, List<NumericMetric> build, List<NumericMetric> generated) {
+        CodeAnalysisResults results = new CodeAnalysisResults();
+        Metadata metadata = new Metadata();
+        metadata.setName(name);
+        results.setMetadata(metadata);
+        results.getMainAspectAnalysisResults().setLinesOfCodePerExtension(main);
+        results.getBuildAndDeployAspectAnalysisResults().setLinesOfCodePerExtension(build);
+        results.getGeneratedAspectAnalysisResults().setLinesOfCodePerExtension(generated);
+        return new RepositoryAnalysisResults(null, results, new ArrayList<>());
+    }
+}
