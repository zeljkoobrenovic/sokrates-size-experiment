+ */
+
+package nl.obren.sokrates.sourcecode.landscape.analysis;
+
+import nl.obren.sokrates.sourcecode.analysis.results.CodeAnalysisResults;
+import nl.obren.sokrates.sourcecode.landscape.LandscapeConfiguration;
+import nl.obren.sokrates.sourcecode.metrics.NumericMetric;
+import org.junit.Test;
+
+import java.util.Arrays;
+import java.util.List;
+
+import static junit.framework.TestCase.assertEquals;
+
+public class LandscapeAnalysisResultsTest {
+    @Test
+    public void mergesLegacyAndBareExtensionNames() throws Exception {
+        LandscapeAnalysisResults landscape = new LandscapeAnalysisResults(null, null);
+        landscape.setConfiguration(new LandscapeConfiguration());
+
+        CodeAnalysisResults legacy = createRepository("legacy");
+        legacy.getMainAspectAnalysisResults().setLinesOfCodePerExtension(Arrays.asList(
+                new NumericMetric("  *.java", 100), new NumericMetric("  *.js", 10)));
+        legacy.getBuildAndDeployAspectAnalysisResults().setLinesOfCodePerExtension(Arrays.asList(
+                new NumericMetric("  *.xml", 5)));
+
+        CodeAnalysisResults current = createRepository("current");
+        current.getMainAspectAnalysisResults().setLinesOfCodePerExtension(Arrays.asList(
+                new NumericMetric("java", 50)));
+        current.getOtherAspectAnalysisResults().setLinesOfCodePerExtension(Arrays.asList(
+                new NumericMetric("xml", 7)));
+
+        landscape.setRepositoryAnalysisResults(Arrays.asList(
+                new RepositoryAnalysisResults(null, legacy, null),
+                new RepositoryAnalysisResults(null, current, null)));
+
+        List<NumericMetric> main = landscape.getMainLinesOfCodePerExtension();
+        assertEquals(2, main.size());
+        assertEquals("java", main.get(0).getName());
+        assertEquals(150, main.get(0).getValue().intValue());
+        assertEquals(2, main.get(0).getDescription().size());
+        assertEquals("js", main.get(1).getName());
+
+        List<NumericMetric> other = landscape.getOtherLinesOfCodePerExtension();
+        assertEquals(1, other.size());
+        assertEquals("xml", other.get(0).getName());
+        assertEquals(12, other.get(0).getValue().intValue());
+        assertEquals(2, other.get(0).getDescription().size());
+    }
+
+    private CodeAnalysisResults createRepository(String name) {
+        CodeAnalysisResults results = new CodeAnalysisResults();
+        results.getMetadata().setName(name);
+        return results;
+    }
+}
