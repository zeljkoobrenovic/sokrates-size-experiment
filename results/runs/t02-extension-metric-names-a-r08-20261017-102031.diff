+package nl.obren.sokrates.sourcecode.landscape.analysis;
+
+import nl.obren.sokrates.sourcecode.analysis.results.CodeAnalysisResults;
+import nl.obren.sokrates.sourcecode.landscape.LandscapeConfiguration;
+import nl.obren.sokrates.sourcecode.landscape.SokratesRepositoryLink;
+import nl.obren.sokrates.sourcecode.metrics.NumericMetric;
+import org.junit.Test;
+
+import java.util.Arrays;
+import java.util.List;
+
+import static org.junit.Assert.*;
+
+public class LandscapeAnalysisResultsTest {
+    @Test
+    public void getMainLinesOfCodePerExtensionMergesOldAndNewExtensionNames() throws Exception {
+        LandscapeAnalysisResults landscape = new LandscapeAnalysisResults(null, null);
+        landscape.setConfiguration(new LandscapeConfiguration());
+        landscape.setRepositoryAnalysisResults(Arrays.asList(
+                repository("old", "main", "  *.java", 100),
+                repository("new", "main", "java", 50)));
+
+        List<NumericMetric> linesOfCode = landscape.getMainLinesOfCodePerExtension();
+
+        assertEquals(1, linesOfCode.size());
+        assertEquals("java", linesOfCode.get(0).getName());
+        assertEquals(150, linesOfCode.get(0).getValue().intValue());
+        assertEquals(2, linesOfCode.get(0).getDescription().size());
+        assertEquals("old", linesOfCode.get(0).getDescription().get(0).getName());
+        assertEquals("new", linesOfCode.get(0).getDescription().get(1).getName());
+    }
+
+    @Test
+    public void getOtherLinesOfCodePerExtensionMergesScopesAndOldAndNewExtensionNames() throws Exception {
+        LandscapeAnalysisResults landscape = new LandscapeAnalysisResults(null, null);
+        landscape.setConfiguration(new LandscapeConfiguration());
+        landscape.setRepositoryAnalysisResults(Arrays.asList(
+                repository("old", "build", "  *.xml", 5),
+                repository("new", "other", "xml", 7)));
+
+        List<NumericMetric> linesOfCode = landscape.getOtherLinesOfCodePerExtension();
+
+        assertEquals(1, linesOfCode.size());
+        assertEquals("xml", linesOfCode.get(0).getName());
+        assertEquals(12, linesOfCode.get(0).getValue().intValue());
+        assertEquals(2, linesOfCode.get(0).getDescription().size());
+    }
+
+    private RepositoryAnalysisResults repository(String name, String scope, String extension, int linesOfCode) {
+        CodeAnalysisResults analysisResults = new CodeAnalysisResults();
+        analysisResults.getMetadata().setName(name);
+        if (scope.equals("main")) {
+            analysisResults.getMainAspectAnalysisResults().getLinesOfCodePerExtension().add(new NumericMetric(extension, linesOfCode));
+        } else if (scope.equals("build")) {
+            analysisResults.getBuildAndDeployAspectAnalysisResults().getLinesOfCodePerExtension().add(new NumericMetric(extension, linesOfCode));
+        } else {
+            analysisResults.getOtherAspectAnalysisResults().getLinesOfCodePerExtension().add(new NumericMetric(extension, linesOfCode));
+        }
+        return new RepositoryAnalysisResults(new SokratesRepositoryLink(), analysisResults, null);
+    }
+}
