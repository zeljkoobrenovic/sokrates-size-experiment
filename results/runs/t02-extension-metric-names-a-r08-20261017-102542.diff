diff --git a/codeanalyzer/src/test/java/nl/obren/sokrates/sourcecode/landscape/analysis/LandscapeAnalysisResultsTest.java b/codeanalyzer/src/test/java/nl/obren/sokrates/sourcecode/landscape/analysis/LandscapeAnalysisResultsTest.java
new file mode 100644
index 0000000..05ea250
--- /dev/null
+++ b/codeanalyzer/src/test/java/nl/obren/sokrates/sourcecode/landscape/analysis/LandscapeAnalysisResultsTest.java
@@ -0,0 +1,73 @@
+package nl.obren.sokrates.sourcecode.landscape.analysis;
+
+import nl.obren.sokrates.sourcecode.analysis.results.CodeAnalysisResults;
+import nl.obren.sokrates.sourcecode.landscape.LandscapeConfiguration;
+import nl.obren.sokrates.sourcecode.landscape.PeopleConfig;
+import nl.obren.sokrates.sourcecode.landscape.TeamsConfig;
+import nl.obren.sokrates.sourcecode.metrics.NumericMetric;
+import org.junit.jupiter.api.Test;
+
+import java.util.Arrays;
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+public class LandscapeAnalysisResultsTest {
+
+    @Test
+    public void getLinesOfCodePerExtensionMergesBareAndLegacyExtensionNames() {
+        LandscapeAnalysisResults landscape = new LandscapeAnalysisResults(new TeamsConfig(), new PeopleConfig());
+        LandscapeConfiguration configuration = new LandscapeConfiguration();
+        configuration.setRepositoryThresholdLocMain(0);
+        configuration.setRepositoryThresholdContributors(0);
+        configuration.setExtensionThresholdLoc(0);
+        landscape.setConfiguration(configuration);
+
+        // repo1 analyzed with the bare extension names, repo2 with the legacy decorated ones
+        landscape.getRepositoryAnalysisResults().add(repository("repo1",
+                Arrays.asList(metric("java", 100), metric("js", 20)),
+                Arrays.asList(metric("xml", 10)),
+                Arrays.asList(metric("xml", 1))));
+        landscape.getRepositoryAnalysisResults().add(repository("repo2",
+                Arrays.asList(metric("  *.java", 50)),
+                Arrays.asList(metric("  *.xml", 5)),
+                Arrays.asList()));
+
+        List<NumericMetric> main = landscape.getMainLinesOfCodePerExtension();
+        assertEquals(2, main.size());
+        assertEquals("java", main.get(0).getName());
+        assertEquals(150, main.get(0).getValue().intValue());
+        assertEquals(2, main.get(0).getDescription().size());
+        assertEquals("repo1", main.get(0).getDescription().get(0).getName());
+        assertEquals("repo2", main.get(0).getDescription().get(1).getName());
+        assertEquals("js", main.get(1).getName());
+        assertEquals(20, main.get(1).getValue().intValue());
+
+        List<NumericMetric> other = landscape.getOtherLinesOfCodePerExtension();
+        assertEquals(1, other.size());
+        assertEquals("xml", other.get(0).getName());
+        assertEquals(16, other.get(0).getValue().intValue());
+        assertEquals(2, other.get(0).getDescription().size());
+        assertEquals("repo1", other.get(0).getDescription().get(0).getName());
+        assertEquals(11, other.get(0).getDescription().get(0).getValue().intValue());
+        assertEquals("repo2", other.get(0).getDescription().get(1).getName());
+        assertEquals(5, other.get(0).getDescription().get(1).getValue().intValue());
+    }
+
+    private static NumericMetric metric(String name, int value) {
+        return new NumericMetric(name, value);
+    }
+
+    private static RepositoryAnalysisResults repository(String name, List<NumericMetric> main,
+                                                        List<NumericMetric> build, List<NumericMetric> other) {
+        CodeAnalysisResults analysisResults = new CodeAnalysisResults();
+        analysisResults.getMetadata().setName(name);
+        analysisResults.getMainAspectAnalysisResults().getLinesOfCodePerExtension().addAll(main);
+        analysisResults.getBuildAndDeployAspectAnalysisResults().getLinesOfCodePerExtension().addAll(build);
+        analysisResults.getOtherAspectAnalysisResults().getLinesOfCodePerExtension().addAll(other);
+
+        RepositoryAnalysisResults repositoryAnalysisResults = new RepositoryAnalysisResults();
+        repositoryAnalysisResults.setAnalysisResults(analysisResults);
+        return repositoryAnalysisResults;
+    }
+}
