+++ b/codeanalyzer/src/test/java/nl/obren/sokrates/sourcecode/landscape/analysis/LandscapeAnalysisResultsTest.java
@@ -0,0 +1,78 @@
+/*
+ * Copyright (c) 2021 Željko Obrenović. All rights reserved.
+ */
+
+package nl.obren.sokrates.sourcecode.landscape.analysis;
+
+import nl.obren.sokrates.sourcecode.Metadata;
+import nl.obren.sokrates.sourcecode.analysis.results.CodeAnalysisResults;
+import nl.obren.sokrates.sourcecode.metrics.NumericMetric;
+import org.junit.Test;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+
+import static org.junit.Assert.*;
+
+public class LandscapeAnalysisResultsTest {
+
+    @Test
+    public void mainLinesOfCodePerExtensionMergesDecoratedAndBareNames() {
+        LandscapeAnalysisResults landscape = landscape(
+                repository("A", metrics("  *.java", 100), null, null, null),
+                repository("B", metrics("java", 50), null, null, null));
+
+        assertEquals(1, landscape.getMainLinesOfCodePerExtension().size());
+        NumericMetric java = landscape.getMainLinesOfCodePerExtension().get(0);
+        assertEquals("java", java.getName());
+        assertEquals(150, java.getValue().intValue());
+        assertEquals(2, java.getDescription().size());
+        assertEquals("A", java.getDescription().get(0).getName());
+        assertEquals("B", java.getDescription().get(1).getName());
+    }
+
+    @Test
+    public void otherLinesOfCodePerExtensionMergesScopesAndSpellings() {
+        LandscapeAnalysisResults landscape = landscape(
+                repository("A", null, null, metrics("  *.xml", 2), metrics("xml", 4)),
+                repository("B", null, metrics("  *.xml", 3), null, null));
+
+        assertEquals(1, landscape.getOtherLinesOfCodePerExtension().size());
+        NumericMetric xml = landscape.getOtherLinesOfCodePerExtension().get(0);
+        assertEquals("xml", xml.getName());
+        assertEquals(9, xml.getValue().intValue());
+        assertEquals(2, xml.getDescription().size());
+        assertEquals("A", xml.getDescription().get(0).getName());
+        assertEquals(6, xml.getDescription().get(0).getValue().intValue());
+        assertEquals("B", xml.getDescription().get(1).getName());
+        assertEquals(3, xml.getDescription().get(1).getValue().intValue());
+    }
+
+    private static LandscapeAnalysisResults landscape(RepositoryAnalysisResults... repositories) {
+        LandscapeAnalysisResults landscape = new LandscapeAnalysisResults(null, null);
+        landscape.setRepositoryAnalysisResults(new ArrayList<>(Arrays.asList(repositories)));
+        return landscape;
+    }
+
+    private static RepositoryAnalysisResults repository(String name, List<NumericMetric> main, List<NumericMetric> build,
+                                                        List<NumericMetric> generated, List<NumericMetric> other) {
+        CodeAnalysisResults results = new CodeAnalysisResults();
+        results.getMetadata().setName(name);
+        addAll(results.getMainAspectAnalysisResults().getLinesOfCodePerExtension(), main);
+        addAll(results.getBuildAndDeployAspectAnalysisResults().getLinesOfCodePerExtension(), build);
+        addAll(results.getGeneratedAspectAnalysisResults().getLinesOfCodePerExtension(), generated);
+        addAll(results.getOtherAspectAnalysisResults().getLinesOfCodePerExtension(), other);
+        return new RepositoryAnalysisResults(null, results, new ArrayList<>());
+    }
+
+    private static List<NumericMetric> metrics(String name, int value) {
+        return Arrays.asList(new NumericMetric(name, value));
+    }
+
+    private static void addAll(List<NumericMetric> target, List<NumericMetric> metrics) {
+        if (metrics != null) {
+            target.addAll(metrics);
+        }
+    }
+}
