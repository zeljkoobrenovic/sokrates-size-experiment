diff --git a/codeanalyzer/src/test/java/nl/obren/sokrates/sourcecode/landscape/analysis/LandscapeAnalysisResultsTest.java b/codeanalyzer/src/test/java/nl/obren/sokrates/sourcecode/landscape/analysis/LandscapeAnalysisResultsTest.java
