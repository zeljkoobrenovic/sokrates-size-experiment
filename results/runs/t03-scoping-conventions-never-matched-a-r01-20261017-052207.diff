+ */
+
+package nl.obren.sokrates.sourcecode.scoping;
+
+import nl.obren.sokrates.sourcecode.SourceFile;
+import org.junit.Test;
+
+import java.io.File;
+import java.util.List;
+
+import static junit.framework.TestCase.assertFalse;
+import static junit.framework.TestCase.assertTrue;
+
+public class ScopingConventionsTest {
+    private final ScopingConventions conventions = new ScopingConventions();
+
+    @Test
+    public void testGeneratedHtmlPagesIncludeHtm() {
+        List<Convention> generated = conventions.getGeneratedFilesConventions();
+        String pkgdown = "<html>\n<!-- Generated by pkgdown: do not edit by hand -->\n</html>";
+        String doxygen = "<html>\n<meta content=\"text/xhtml;charset=UTF-8\"/>\n<!-- Generated by Doxygen 1.9 -->\n</html>";
+        String meta = "<html>\n<head>\n<meta name=\"generator\" content=\"Hugo\" />\n</head>\n</html>";
+
+        assertTrue(isGenerated(generated, "docs/index.htm", pkgdown));
+        assertTrue(isGenerated(generated, "docs/index.html", pkgdown));
+        assertTrue(isGenerated(generated, "docs/index.htm", doxygen));
+        assertTrue(isGenerated(generated, "docs/index.html", doxygen));
+        assertTrue(isGenerated(generated, "docs/index.htm", meta));
+        assertTrue(isGenerated(generated, "docs/index.xhtml", meta));
+        assertFalse(isGenerated(generated, "docs/index.htm", "<html><body>hand written</body></html>"));
+    }
+
+    @Test
+    public void testDotNetDocumentationFileMatchesNamedXml() {
+        List<Convention> generated = conventions.getGeneratedFilesConventions();
+        String docXml = "<?xml version=\"1.0\"?>\n<doc>\n<assembly>\n</assembly>\n</doc>";
+
+        assertTrue(isGenerated(generated, "bin/MyAssembly.xml", docXml));
+        assertTrue(isGenerated(generated, "bin/.xml", docXml));
+        assertFalse(isGenerated(generated, "config/settings.xml", "<settings>\n</settings>"));
+    }
+
+    @Test
+    public void testGeneratedJavaScriptMatchesNamedJs() {
+        List<Convention> generated = conventions.getGeneratedFilesConventions();
+
+        assertTrue(isGenerated(generated, "src/app.js", "// Generated by some tool\nvar a = 1;"));
+        assertFalse(isGenerated(generated, "src/app.js", "// hand written\nvar a = 1;"));
+    }
+
+    @Test
+    public void testGradleJavaScriptScriptIsBuildAndDeployment() {
+        List<Convention> buildAndDeployment = conventions.getBuildAndDeploymentFilesConventions();
+
+        assertTrue(isMatched(buildAndDeployment, "scripts/build-gradle.js", ""));
+        assertTrue(isMatched(buildAndDeployment, "build.gradle", ""));
+        assertFalse(isMatched(buildAndDeployment, "src/app.js", ""));
+    }
+
+    private boolean isGenerated(List<Convention> conventions, String path, String content) {
+        return isMatched(conventions, path, content);
+    }
+
+    private boolean isMatched(List<Convention> conventions, String path, String content) {
+        SourceFile sourceFile = new SourceFile(new File(path), content);
+        return conventions.stream().anyMatch(convention -> convention.matches(sourceFile));
+    }
+}
