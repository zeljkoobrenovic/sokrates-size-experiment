+ */
+
+package nl.obren.sokrates.sourcecode.scoping;
+
+import nl.obren.sokrates.sourcecode.SourceFile;
+import nl.obren.sokrates.sourcecode.SourceFileFilter;
+import org.junit.Assert;
+import org.junit.Test;
+
+import java.io.File;
+import java.util.List;
+
+public class ScopingConventionsTest {
+    private final ScopingConventions conventions = new ScopingConventions();
+
+    private boolean matches(List<? extends SourceFileFilter> filters, String path, String content) {
+        SourceFile sourceFile = new SourceFile(new File(path), content);
+        return filters.stream().anyMatch(filter -> filter.matches(sourceFile));
+    }
+
+    @Test
+    public void generatedHtmlPagesWithHtmExtensionMatch() {
+        String pkgdown = "<!-- Generated by pkgdown: do not edit by hand -->\n<html></html>";
+        String doxygen = "<html>\n<!-- Generated by Doxygen 1.9 -->\n</html>";
+        String meta = "<html>\n<head>\n<meta name=\"generator\" content=\"tool\">\n</head>";
+
+        Assert.assertTrue(matches(conventions.getGeneratedFilesConventions(), "docs/index.htm", pkgdown));
+        Assert.assertTrue(matches(conventions.getGeneratedFilesConventions(), "docs/index.htm", doxygen));
+        Assert.assertTrue(matches(conventions.getGeneratedFilesConventions(), "docs/index.htm", meta));
+        Assert.assertTrue(matches(conventions.getGeneratedFilesConventions(), "docs/index.html", doxygen));
+        Assert.assertTrue(matches(conventions.getGeneratedFilesConventions(), "docs/index.xhtml", meta));
+    }
+
+    @Test
+    public void handWrittenHtmlPagesAreNotGenerated() {
+        String content = "<html>\n<head>\n<title>Hand written</title>\n</head>\n</html>";
+
+        Assert.assertFalse(matches(conventions.getGeneratedFilesConventions(), "site/index.htm", content));
+        Assert.assertFalse(matches(conventions.getGeneratedFilesConventions(), "site/index.html", content));
+    }
+
+    @Test
+    public void dotNetDocumentationXmlMatches() {
+        String content = "<?xml version=\"1.0\"?>\n<doc>\n<assembly>";
+
+        Assert.assertTrue(matches(conventions.getGeneratedFilesConventions(), "bin/MyAssembly.xml", content));
+        Assert.assertFalse(matches(conventions.getGeneratedFilesConventions(), "config/settings.xml", "<settings/>"));
+    }
+
+    @Test
+    public void generatedJavaScriptMatches() {
+        String content = "// Generated by PEG.js\nvar x = 1;";
+
+        Assert.assertTrue(matches(conventions.getGeneratedFilesConventions(), "src/app.js", content));
+        Assert.assertFalse(matches(conventions.getGeneratedFilesConventions(), "src/app.js", "var x = 1;"));
+    }
+
+    @Test
+    public void gradleJavaScriptScriptsAreBuildFiles() {
+        Assert.assertTrue(matches(conventions.getBuildAndDeploymentFilesConventions(), "tools/build-gradle.js", ""));
+        Assert.assertTrue(matches(conventions.getBuildAndDeploymentFilesConventions(), "build.gradle", ""));
+        Assert.assertFalse(matches(conventions.getBuildAndDeploymentFilesConventions(), "src/app.js", ""));
+    }
+}
