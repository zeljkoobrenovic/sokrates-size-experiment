+ */
+
+package nl.obren.sokrates.sourcecode.scoping;
+
+import nl.obren.sokrates.sourcecode.SourceFileFilter;
+import org.junit.jupiter.api.Test;
+
+import java.util.Arrays;
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+public class ScopingConventionsTest {
+    private final ScopingConventions conventions = new ScopingConventions();
+
+    @Test
+    public void generatedHtmlConventionsMatchHtmAndHtml() {
+        List<String> pkgdown = Arrays.asList("<!-- Generated by pkgdown: do not edit by hand -->");
+        assertTrue(anyMatch(conventions.getGeneratedFilesConventions(), "docs/index.htm", pkgdown));
+        assertTrue(anyMatch(conventions.getGeneratedFilesConventions(), "docs/index.html", pkgdown));
+
+        List<String> doxygen = Arrays.asList("<!-- Generated by Doxygen 1.9.1 -->");
+        assertTrue(anyMatch(conventions.getGeneratedFilesConventions(), "docs/page.htm", doxygen));
+        assertTrue(anyMatch(conventions.getGeneratedFilesConventions(), "docs/page.html", doxygen));
+
+        List<String> meta = Arrays.asList("<meta name=\"generator\" content=\"tool\" />");
+        assertTrue(anyMatch(conventions.getGeneratedFilesConventions(), "docs/page.htm", meta));
+        assertTrue(anyMatch(conventions.getGeneratedFilesConventions(), "docs/page.xhtml", meta));
+
+        List<String> handWritten = Arrays.asList("<html>", "<body>hello</body>");
+        assertFalse(anyMatch(conventions.getGeneratedFilesConventions(), "docs/page.htm", handWritten));
+    }
+
+    @Test
+    public void generatedXmlAndJsConventionsMatchRealFileNames() {
+        List<String> doc = Arrays.asList("<?xml version=\"1.0\"?>", "<doc>");
+        assertTrue(anyMatch(conventions.getGeneratedFilesConventions(), "bin/MyAssembly.xml", doc));
+        assertFalse(anyMatch(conventions.getGeneratedFilesConventions(), "src/config.xml", Arrays.asList("<config>", "<item/>")));
+
+        List<String> js = Arrays.asList("// Generated by Something", "var a = 1;");
+        assertTrue(anyMatch(conventions.getGeneratedFilesConventions(), "src/app.js", js));
+        assertFalse(anyMatch(conventions.getGeneratedFilesConventions(), "src/app.js", Arrays.asList("var a = 1;")));
+    }
+
+    @Test
+    public void gradleJavaScriptBuildFilesMatch() {
+        assertTrue(anyMatch(conventions.getBuildAndDeploymentFilesConventions(), "project/build-gradle.js", Arrays.asList()));
+        assertTrue(anyMatch(conventions.getBuildAndDeploymentFilesConventions(), "project/.-gradle.js", Arrays.asList()));
+        assertFalse(anyMatch(conventions.getBuildAndDeploymentFilesConventions(), "project/app.js", Arrays.asList()));
+    }
+
+    private boolean anyMatch(List<? extends SourceFileFilter> filters, String path, List<String> lines) {
+        return filters.stream().anyMatch(filter -> filter.pathMatches(path)
+                && (filter.getContentPattern().isEmpty() || SourceFileFilter.matchesAnyLine(lines, filter.getContentPattern())));
+    }
+}
