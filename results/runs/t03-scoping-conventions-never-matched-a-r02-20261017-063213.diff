+++ b/codeanalyzer/src/test/java/nl/obren/sokrates/sourcecode/scoping/ScopingConventionsTest.java
@@ -0,0 +1,67 @@
+/*
+ * Copyright (c) 2021 Željko Obrenović. All rights reserved.
+ */
+
+package nl.obren.sokrates.sourcecode.scoping;
+
+import nl.obren.sokrates.sourcecode.SourceFileFilter;
+import org.junit.Test;
+
+import java.util.Collections;
+import java.util.List;
+
+import static junit.framework.TestCase.assertFalse;
+import static junit.framework.TestCase.assertTrue;
+
+public class ScopingConventionsTest {
+    private final ScopingConventions conventions = new ScopingConventions();
+
+    @Test
+    public void testHtmlGeneratedConventionsMatchHtm() {
+        List<Convention> generated = conventions.getGeneratedFilesConventions();
+
+        assertTrue(anyMatch(generated, "docs/index.htm", "<p>Generated by pkgdown: do not edit by hand</p>"));
+        assertTrue(anyMatch(generated, "docs/index.html", "<p>Generated by pkgdown: do not edit by hand</p>"));
+        assertTrue(anyMatch(generated, "docs/index.htm", "<!-- Generated by Doxygen 1.9.1 -->"));
+        assertTrue(anyMatch(generated, "docs/index.html", "<!-- Generated by Doxygen 1.9.1 -->"));
+        assertTrue(anyMatch(generated, "docs/index.htm", "<meta name=\"generator\" content=\"Hugo\">"));
+        assertTrue(anyMatch(generated, "docs/index.xhtml", "<meta name=\"generator\" content=\"Hugo\">"));
+
+        assertFalse(anyMatch(generated, "docs/index.htm", "<p>Hello</p>"));
+    }
+
+    @Test
+    public void testDotNetDocXmlMatches() {
+        List<Convention> generated = conventions.getGeneratedFilesConventions();
+
+        assertTrue(anyMatch(generated, "bin/MyAssembly.xml", "<doc>"));
+        assertTrue(anyMatch(generated, "bin/.xml", "<doc>"));
+        assertFalse(anyMatch(generated, "config/settings.xml", "<settings>"));
+    }
+
+    @Test
+    public void testGeneratedJsMatches() {
+        List<Convention> generated = conventions.getGeneratedFilesConventions();
+
+        assertTrue(anyMatch(generated, "src/app.js", "// Generated by some tool"));
+        assertFalse(anyMatch(generated, "src/app.js", "// Hand written code"));
+    }
+
+    @Test
+    public void testGradleJsIsBuildAndDeployment() {
+        List<Convention> buildAndDeployment = conventions.getBuildAndDeploymentFilesConventions();
+
+        assertTrue(anyPathMatch(buildAndDeployment, "tools/build-gradle.js"));
+        assertTrue(anyPathMatch(buildAndDeployment, "build.gradle"));
+        assertFalse(anyPathMatch(buildAndDeployment, "src/app.js"));
+    }
+
+    private boolean anyMatch(List<Convention> conventions, String path, String line) {
+        return conventions.stream().anyMatch(convention ->
+                convention.pathMatches(path) && SourceFileFilter.matchesAnyLine(Collections.singletonList(line), convention.getContentPattern()));
+    }
+
+    private boolean anyPathMatch(List<Convention> conventions, String path) {
+        return conventions.stream().anyMatch(convention -> convention.pathMatches(path));
+    }
+}
