@@ -0,0 +1,55 @@
+/*
+ * Copyright (c) 2021 Željko Obrenović. All rights reserved.
+ */
+
+package nl.obren.sokrates.sourcecode.scoping;
+
+import nl.obren.sokrates.sourcecode.SourceFile;
+import org.junit.jupiter.api.Test;
+
+import java.io.File;
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class ScopingConventionsDefaultsTest {
+    private final ScopingConventions conventions = new ScopingConventions();
+
+    private boolean matchesAny(List<Convention> list, String path, String content) {
+        SourceFile sourceFile = new SourceFile(new File(path), content);
+        return list.stream().anyMatch(convention -> convention.matches(sourceFile));
+    }
+
+    @Test
+    void generatedHtmlPagesWithHtmExtensionAreMatched() {
+        List<Convention> generated = conventions.getGeneratedFilesConventions();
+        assertTrue(matchesAny(generated, "docs/index.htm", "<!-- Generated by pkgdown: do not edit by hand -->"));
+        assertTrue(matchesAny(generated, "docs/index.htm", "<html>\n<head>\n<meta name=\"generator\" content=\"Doxygen 1.9\">"));
+        assertTrue(matchesAny(generated, "docs/index.html", "<!-- Generated by Doxygen 1.9 -->"));
+        assertTrue(matchesAny(generated, "docs/index.xhtml", "<meta name=\"generator\" content=\"tool\" />"));
+        assertFalse(matchesAny(generated, "docs/index.htm", "<html><body>hand written</body></html>"));
+    }
+
+    @Test
+    void dotNetDocumentationXmlIsMatched() {
+        List<Convention> generated = conventions.getGeneratedFilesConventions();
+        assertTrue(matchesAny(generated, "bin/MyAssembly.xml", "<?xml version=\"1.0\"?>\n<doc>\n"));
+        assertFalse(matchesAny(generated, "config/settings.xml", "<?xml version=\"1.0\"?>\n<settings>\n"));
+    }
+
+    @Test
+    void generatedJavaScriptIsMatched() {
+        List<Convention> generated = conventions.getGeneratedFilesConventions();
+        assertTrue(matchesAny(generated, "src/app.js", "// Generated by some tool\nvar x = 1;"));
+        assertFalse(matchesAny(generated, "src/app.js", "// hand written\nvar x = 1;"));
+    }
+
+    @Test
+    void gradleJavaScriptScriptsAreBuildAndDeployment() {
+        List<Convention> buildAndDeployment = conventions.getBuildAndDeploymentFilesConventions();
+        assertTrue(matchesAny(buildAndDeployment, "tools/build-gradle.js", ""));
+        assertTrue(matchesAny(buildAndDeployment, "build.gradle", ""));
+        assertFalse(matchesAny(buildAndDeployment, "src/app.js", ""));
+    }
+}
