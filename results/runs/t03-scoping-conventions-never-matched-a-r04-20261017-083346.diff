@@ -0,0 +1,73 @@
+package nl.obren.sokrates.sourcecode.scoping;
+
+import nl.obren.sokrates.sourcecode.SourceFileFilter;
+import org.junit.Test;
+
+import java.util.Arrays;
+import java.util.List;
+
+import static org.junit.Assert.*;
+
+public class ScopingConventionsTest {
+    @Test
+    public void generatedHtmlPagesIncludeHtm() {
+        List<String> pkgdown = Arrays.asList("<!-- Generated by pkgdown: do not edit by hand -->");
+        List<String> doxygen = Arrays.asList("<!-- HTML header", "<meta http-equiv=\"Content-Type\"/>", "Generated by Doxygen 1.9");
+        List<String> meta = Arrays.asList("<html>", "  <meta name=\"generator\" content=\"Hugo\">");
+
+        assertTrue(isGenerated("docs/index.htm", pkgdown));
+        assertTrue(isGenerated("docs/index.html", pkgdown));
+        assertTrue(isGenerated("docs/page.htm", doxygen));
+        assertTrue(isGenerated("docs/page.html", doxygen));
+        assertTrue(isGenerated("docs/page.xhtml", meta));
+        assertTrue(isGenerated("docs/page.htm", meta));
+        assertFalse(isGenerated("docs/hand-written.htm", Arrays.asList("<html>", "<body>Hello</body>")));
+    }
+
+    @Test
+    public void generatedDotNetDocumentationXmlAndJs() {
+        List<String> dotNetDoc = Arrays.asList("<?xml version=\"1.0\"?>", "<doc>", "<assembly>");
+        assertTrue(isGenerated("bin/MyAssembly.xml", dotNetDoc));
+        assertTrue(isGenerated("MyAssembly.xml", dotNetDoc));
+        assertFalse(isGenerated("config/settings.xml", Arrays.asList("<settings>", "<value/>")));
+
+        List<String> generatedJs = Arrays.asList("// Generated by Some Tool", "var a = 1;");
+        assertTrue(isGenerated("src/app.js", generatedJs));
+        assertFalse(isGenerated("src/app.js", Arrays.asList("// hand written", "var a = 1;")));
+    }
+
+    @Test
+    public void gradleJavaScriptScriptsAreBuildAndDeployment() {
+        ScopingConventions conventions = new ScopingConventions();
+        assertTrue(isBuildAndDeployment(conventions, "build-gradle.js"));
+        assertTrue(isBuildAndDeployment(conventions, "tools/.-gradle.js"));
+        assertTrue(isBuildAndDeployment(conventions, "build.gradle"));
+        assertFalse(isBuildAndDeployment(conventions, "src/app.js"));
+    }
+
+    private boolean isGenerated(String path, List<String> lines) {
+        return matches(new ScopingConventions().getGeneratedFilesConventions(), path, lines);
+    }
+
+    private boolean isBuildAndDeployment(ScopingConventions conventions, String path) {
+        return matches(conventions.getBuildAndDeploymentFilesConventions(), path, Arrays.asList());
+    }
+
+    private boolean matches(List<Convention> conventions, String path, List<String> lines) {
+        for (Convention convention : conventions) {
+            if (convention.pathMatches(path) && contentMatches(convention, lines)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private boolean contentMatches(SourceFileFilter filter, List<String> lines) {
+        if (filter.getContentPattern().isEmpty()) {
+            return true;
+        }
+        int max = filter.getMaxLinesForContentSearch();
+        List<String> searched = max < 0 || max > lines.size() ? lines : lines.subList(0, max);
+        return SourceFileFilter.matchesAnyLine(searched, filter.getContentPattern());
+    }
+}
