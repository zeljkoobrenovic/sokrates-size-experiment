+ */
+
+package nl.obren.sokrates.sourcecode.scoping;
+
+import nl.obren.sokrates.sourcecode.SourceFile;
+import org.junit.Test;
+
+import java.io.File;
+import java.util.List;
+
+import static junit.framework.TestCase.assertFalse;
+import static junit.framework.TestCase.assertTrue;
+
+public class ScopingConventionsTest {
+    private final ScopingConventions conventions = new ScopingConventions();
+
+    @Test
+    public void testGeneratedHtmlPages() {
+        String pkgdown = "<html>\n<!-- Generated by pkgdown: do not edit by hand -->\n</html>";
+        String doxygen = "<html>\n<!-- Generated by Doxygen 1.9 -->\n</html>";
+        String generator = "<html>\n<head>\n<meta name=\"generator\" content=\"tool\" />\n</head>\n</html>";
+        String handWritten = "<html>\n<body>hello</body>\n</html>";
+
+        assertTrue(isGenerated("/docs/index.htm", pkgdown));
+        assertTrue(isGenerated("/docs/index.html", pkgdown));
+        assertTrue(isGenerated("/docs/index.htm", doxygen));
+        assertTrue(isGenerated("/docs/index.html", doxygen));
+        assertTrue(isGenerated("/docs/index.htm", generator));
+        assertTrue(isGenerated("/docs/index.xhtml", generator));
+        assertFalse(isGenerated("/docs/index.htm", handWritten));
+        assertFalse(isGenerated("/docs/index.html", handWritten));
+    }
+
+    @Test
+    public void testGeneratedDotNetDocumentationAndJs() {
+        String dotNetDoc = "<?xml version=\"1.0\"?>\n<doc>\n<assembly>\n</assembly>\n</doc>";
+        String plainXml = "<?xml version=\"1.0\"?>\n<config>\n</config>";
+        String generatedJs = "// Generated by SomeTool\nvar a = 1;";
+        String handWrittenJs = "// some comment\nvar a = 1;";
+
+        assertTrue(isGenerated("/bin/MyAssembly.xml", dotNetDoc));
+        assertFalse(isGenerated("/config/settings.xml", plainXml));
+        assertTrue(isGenerated("/src/app.js", generatedJs));
+        assertFalse(isGenerated("/src/app.js", handWrittenJs));
+    }
+
+    @Test
+    public void testGradleJavaScriptIsBuildAndDeployment() {
+        assertTrue(isBuildAndDeployment("/android/build-gradle.js"));
+        assertTrue(isBuildAndDeployment("/android/build.gradle"));
+        assertFalse(isBuildAndDeployment("/src/app.js"));
+    }
+
+    private boolean isGenerated(String path, String content) {
+        return matchesAny(conventions.getGeneratedFilesConventions(), path, content);
+    }
+
+    private boolean isBuildAndDeployment(String path) {
+        return matchesAny(conventions.getBuildAndDeploymentFilesConventions(), path, "");
+    }
+
+    private boolean matchesAny(List<Convention> list, String path, String content) {
+        SourceFile sourceFile = new SourceFile(new File(path), content);
+        return list.stream().anyMatch(convention -> convention.matches(sourceFile));
+    }
+}
