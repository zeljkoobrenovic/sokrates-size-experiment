+ */
+
+package nl.obren.sokrates.sourcecode.scoping;
+
+import nl.obren.sokrates.sourcecode.SourceFile;
+import org.junit.Test;
+
+import java.io.File;
+
+import static junit.framework.TestCase.assertFalse;
+import static junit.framework.TestCase.assertTrue;
+
+public class ScopingConventionsTest {
+    private final ScopingConventions conventions = new ScopingConventions();
+
+    private boolean matchesAny(java.util.List<Convention> list, String path, String content) {
+        SourceFile sourceFile = new SourceFile(new File(path), content);
+        for (Convention convention : list) {
+            if (convention.matches(sourceFile)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private boolean isGenerated(String path, String content) {
+        return matchesAny(conventions.getGeneratedFilesConventions(), path, content);
+    }
+
+    private boolean isBuildAndDeploy(String path, String content) {
+        return matchesAny(conventions.getBuildAndDeploymentFilesConventions(), path, content);
+    }
+
+    @Test
+    public void generatedHtmlPagesWithHtmExtension() {
+        assertTrue(isGenerated("/site/index.htm", "<html>\n# Generated by pkgdown: do not edit by hand\n"));
+        assertTrue(isGenerated("/docs/page.htm", "<!-- Generated by Doxygen 1.8 -->\n"));
+        assertTrue(isGenerated("/docs/page.htm", "<html>\n<head>\n<meta name=\"generator\" content=\"tool\" />\n"));
+    }
+
+    @Test
+    public void generatedHtmlPagesWithExistingExtensions() {
+        assertTrue(isGenerated("/docs/page.html", "<!-- Generated by Doxygen 1.8 -->\n"));
+        assertTrue(isGenerated("/docs/page.xhtml", "<head>\n<meta name=\"generator\" content=\"tool\" />\n"));
+    }
+
+    @Test
+    public void handWrittenHtmlPagesAreNotGenerated() {
+        assertFalse(isGenerated("/site/index.htm", "<html>\n<body>hello</body>\n"));
+        assertFalse(isGenerated("/site/index.html", "<html>\n<body>hello</body>\n"));
+    }
+
+    @Test
+    public void dotNetDocumentationXmlIsGenerated() {
+        assertTrue(isGenerated("/bin/MyAssembly.xml", "<?xml version=\"1.0\"?>\n<doc>\n"));
+    }
+
+    @Test
+    public void handWrittenXmlIsNotGenerated() {
+        assertFalse(isGenerated("/config/app.xml", "<?xml version=\"1.0\"?>\n<config>\n"));
+    }
+
+    @Test
+    public void generatedJavaScriptIsGenerated() {
+        assertTrue(isGenerated("/src/app.js", "// Generated by some-tool\nvar a = 1;\n"));
+    }
+
+    @Test
+    public void handWrittenJavaScriptIsNotGenerated() {
+        assertFalse(isGenerated("/src/app.js", "var a = 1;\n"));
+    }
+
+    @Test
+    public void gradleJavaScriptIsBuildAndDeploy() {
+        assertTrue(isBuildAndDeploy("/scripts/build-gradle.js", "var a = 1;\n"));
+        assertTrue(isBuildAndDeploy("/scripts/build.gradle", "apply plugin: 'java'\n"));
+    }
+
+    @Test
+    public void otherJavaScriptIsNotBuildAndDeploy() {
+        assertFalse(isBuildAndDeploy("/scripts/build.js", "var a = 1;\n"));
+    }
+}
