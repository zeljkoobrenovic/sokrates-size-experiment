+ */
+
+package nl.obren.sokrates.sourcecode.scoping;
+
+import nl.obren.sokrates.sourcecode.SourceFile;
+import org.junit.Test;
+
+import java.io.File;
+import java.util.List;
+
+import static junit.framework.TestCase.assertFalse;
+import static junit.framework.TestCase.assertTrue;
+
+public class ScopingConventionsTest {
+    private final ScopingConventions conventions = new ScopingConventions();
+
+    @Test
+    public void generatedHtmlPagesIncludeHtm() {
+        String pkgdown = "<!-- Generated by pkgdown: do not edit by hand -->\n<html></html>";
+        String doxygen = "<html>\n<!-- Generated by Doxygen 1.9 -->\n</html>";
+        String meta = "<html>\n<head>\n<meta name=\"generator\" content=\"Hugo\">\n</head>\n</html>";
+
+        assertTrue(isGenerated(new File("docs/index.htm"), pkgdown));
+        assertTrue(isGenerated(new File("docs/index.htm"), doxygen));
+        assertTrue(isGenerated(new File("docs/index.htm"), meta));
+        assertTrue(isGenerated(new File("docs/index.html"), doxygen));
+        assertTrue(isGenerated(new File("docs/index.xhtml"), meta));
+        assertFalse(isGenerated(new File("docs/index.htm"), "<html><body>Hand written</body></html>"));
+    }
+
+    @Test
+    public void dotNetDocumentationXmlIsGenerated() {
+        String docXml = "<?xml version=\"1.0\"?>\n<doc>\n<assembly><name>MyAssembly</name></assembly>\n</doc>";
+
+        assertTrue(isGenerated(new File("bin/MyAssembly.xml"), docXml));
+        assertFalse(isGenerated(new File("config/settings.xml"), "<settings>\n</settings>"));
+    }
+
+    @Test
+    public void jsGeneratedByHeaderIsGenerated() {
+        assertTrue(isGenerated(new File("src/app.js"), "// Generated by SomeTool\nvar a = 1;"));
+        assertFalse(isGenerated(new File("src/app.js"), "// Hand written\nvar a = 1;"));
+    }
+
+    @Test
+    public void gradleJavaScriptIsBuildAndDeployment() {
+        assertTrue(isBuildAndDeployment(new File("tools/build-gradle.js")));
+        assertTrue(isBuildAndDeployment(new File("tools/.-gradle.js")));
+        assertFalse(isBuildAndDeployment(new File("src/app.js")));
+    }
+
+    @Test
+    public void buildGradleIsBuildAndDeployment() {
+        assertTrue(isBuildAndDeployment(new File("project/build.gradle")));
+    }
+
+    private boolean isGenerated(File file, String content) {
+        return matchesAny(conventions.getGeneratedFilesConventions(), new SourceFile(file, content));
+    }
+
+    private boolean isBuildAndDeployment(File file) {
+        return matchesAny(conventions.getBuildAndDeploymentFilesConventions(), new SourceFile(file, ""));
+    }
+
+    private boolean matchesAny(List<Convention> list, SourceFile sourceFile) {
+        return list.stream().anyMatch(convention -> convention.matches(sourceFile));
+    }
+}
