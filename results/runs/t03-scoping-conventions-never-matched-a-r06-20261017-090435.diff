+ */
+
+package nl.obren.sokrates.sourcecode.scoping;
+
+import nl.obren.sokrates.sourcecode.SourceFile;
+import org.junit.Test;
+
+import java.io.File;
+import java.lang.reflect.Field;
+import java.util.List;
+
+import static junit.framework.TestCase.assertFalse;
+import static junit.framework.TestCase.assertTrue;
+
+public class ScopingConventionsTest {
+    @Test
+    public void testGeneratedHtmlConventionsMatchHtmAndHtml() throws Exception {
+        List<Convention> generated = getConventions("generatedFilesConventions");
+
+        assertTrue(matchesAny(generated, "docs/index.htm", "<!-- Generated by pkgdown: do not edit by hand -->"));
+        assertTrue(matchesAny(generated, "docs/index.htm", "<h1>Generated by Doxygen</h1>"));
+        assertTrue(matchesAny(generated, "docs/index.htm", "<meta name=\"generator\" content=\"Doxygen 1.9\">"));
+        assertTrue(matchesAny(generated, "docs/index.html", "<h1>Generated by Doxygen</h1>"));
+        assertTrue(matchesAny(generated, "docs/index.xhtml", "<meta name=\"generator\" content=\"Doxygen 1.9\">"));
+
+        assertFalse(matchesAny(generated, "docs/index.htm", "<h1>Hello</h1>"));
+    }
+
+    @Test
+    public void testGeneratedDotNetDocAndJsConventions() throws Exception {
+        List<Convention> generated = getConventions("generatedFilesConventions");
+
+        assertTrue(matchesAny(generated, "bin/MyAssembly.xml", "<?xml version=\"1.0\"?>\n<doc>"));
+        assertTrue(matchesAny(generated, "src/app.js", "// Generated by some tool"));
+
+        assertFalse(matchesAny(generated, "src/config.xml", "<configuration>"));
+        assertFalse(matchesAny(generated, "src/app.js", "var a = 1;"));
+    }
+
+    @Test
+    public void testGradleJsConventionMatchesAnyGradleJs() throws Exception {
+        List<Convention> buildAndDeploy = getConventions("buildAndDeploymentFilesConventions");
+
+        assertTrue(matchesAny(buildAndDeploy, "tools/build-gradle.js", ""));
+        assertTrue(matchesAny(buildAndDeploy, "tools/.-gradle.js", ""));
+        assertTrue(matchesAny(buildAndDeploy, "build.gradle", ""));
+
+        assertFalse(matchesAny(buildAndDeploy, "tools/build.js", ""));
+    }
+
+    private static boolean matchesAny(List<Convention> conventions, String path, String content) {
+        SourceFile sourceFile = new SourceFile(new File(path), content);
+        return conventions.stream().anyMatch(convention -> convention.matches(sourceFile));
+    }
+
+    @SuppressWarnings("unchecked")
+    private static List<Convention> getConventions(String fieldName) throws Exception {
+        Field field = ScopingConventions.class.getDeclaredField(fieldName);
+        field.setAccessible(true);
+        return (List<Convention>) field.get(new ScopingConventions());
+    }
+}
