+ */
+
+package nl.obren.sokrates.sourcecode.scoping;
+
+import nl.obren.sokrates.sourcecode.SourceFile;
+import org.junit.jupiter.api.Test;
+
+import java.io.File;
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+public class ScopingConventionsTest {
+    private final ScopingConventions scopingConventions = new ScopingConventions();
+
+    private boolean isMatchedBy(List<Convention> conventions, String path, String content) {
+        SourceFile sourceFile = new SourceFile(new File(path), content);
+        return conventions.stream().anyMatch(convention -> convention.matches(sourceFile));
+    }
+
+    @Test
+    public void generatedHtmlPagesWithHtmExtensionAreMatched() {
+        List<Convention> generated = scopingConventions.getGeneratedFilesConventions();
+        assertTrue(isMatchedBy(generated, "docs/index.htm", "<!-- Generated by pkgdown: do not edit by hand -->"));
+        assertTrue(isMatchedBy(generated, "docs/index.htm", "<!-- Generated by Doxygen 1.9.1 -->"));
+        assertTrue(isMatchedBy(generated, "docs/index.htm", "<meta name=\"generator\" content=\"Doxygen 1.9.1\">"));
+        assertTrue(isMatchedBy(generated, "docs/index.html", "<!-- Generated by Doxygen 1.9.1 -->"));
+        assertTrue(isMatchedBy(generated, "docs/index.xhtml", "<meta name=\"generator\" content=\"Doxygen 1.9.1\">"));
+    }
+
+    @Test
+    public void handWrittenHtmPagesAreNotMatched() {
+        List<Convention> generated = scopingConventions.getGeneratedFilesConventions();
+        assertFalse(isMatchedBy(generated, "docs/index.htm", "<html><body>Hello</body></html>"));
+    }
+
+    @Test
+    public void dotNetDocumentationXmlFilesAreMatched() {
+        List<Convention> generated = scopingConventions.getGeneratedFilesConventions();
+        assertTrue(isMatchedBy(generated, "src/MyAssembly.xml", "<?xml version=\"1.0\"?>\n<doc>"));
+        assertFalse(isMatchedBy(generated, "src/MyAssembly.xml", "<?xml version=\"1.0\"?>\n<config>"));
+    }
+
+    @Test
+    public void generatedJavaScriptFilesAreMatched() {
+        List<Convention> generated = scopingConventions.getGeneratedFilesConventions();
+        assertTrue(isMatchedBy(generated, "src/app.js", "// Generated by some tool\nvar a = 1;"));
+        assertFalse(isMatchedBy(generated, "src/app.js", "// Hand written\nvar a = 1;"));
+    }
+
+    @Test
+    public void gradleJavaScriptScriptsAreBuildAndDeployment() {
+        List<Convention> buildAndDeployment = scopingConventions.getBuildAndDeploymentFilesConventions();
+        assertTrue(isMatchedBy(buildAndDeployment, "tools/build-gradle.js", ""));
+        assertTrue(isMatchedBy(buildAndDeployment, "build.gradle", ""));
+        assertFalse(isMatchedBy(buildAndDeployment, "src/app.js", ""));
+    }
+}
