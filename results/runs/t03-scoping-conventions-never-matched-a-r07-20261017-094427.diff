+ */
+
+package nl.obren.sokrates.sourcecode.scoping;
+
+import nl.obren.sokrates.sourcecode.SourceFile;
+import org.junit.jupiter.api.Test;
+
+import java.io.File;
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+public class ScopingConventionsTest {
+    private final ScopingConventions conventions = new ScopingConventions();
+
+    private boolean matches(List<Convention> list, String path, String content) {
+        SourceFile sourceFile = new SourceFile(new File(path), content);
+        return list.stream().anyMatch(convention -> convention.matches(sourceFile));
+    }
+
+    @Test
+    public void generatedHtmlPagesWithHtmExtension() {
+        String pkgdown = "<html>\n<!-- Generated by pkgdown: do not edit by hand -->\n</html>";
+        String doxygen = "<html>\n<!-- Generated by Doxygen 1.9 -->\n</html>";
+        String meta = "<html>\n<head>\n<meta name=\"generator\" content=\"Hugo\" />\n</head>\n</html>";
+
+        assertTrue(matches(conventions.getGeneratedFilesConventions(), "docs/index.htm", pkgdown));
+        assertTrue(matches(conventions.getGeneratedFilesConventions(), "docs/index.htm", doxygen));
+        assertTrue(matches(conventions.getGeneratedFilesConventions(), "docs/index.htm", meta));
+        assertTrue(matches(conventions.getGeneratedFilesConventions(), "docs/index.html", doxygen));
+        assertTrue(matches(conventions.getGeneratedFilesConventions(), "docs/index.xhtml", meta));
+    }
+
+    @Test
+    public void handWrittenHtmPagesAreNotGenerated() {
+        String content = "<html>\n<head>\n<title>Hello</title>\n</head>\n</html>";
+
+        assertFalse(matches(conventions.getGeneratedFilesConventions(), "site/index.htm", content));
+    }
+
+    @Test
+    public void dotNetDocumentationXmlFilesAreGenerated() {
+        String content = "<?xml version=\"1.0\"?>\n<doc>\n<assembly>\n</assembly>\n</doc>";
+
+        assertTrue(matches(conventions.getGeneratedFilesConventions(), "bin/MyAssembly.xml", content));
+    }
+
+    @Test
+    public void handWrittenXmlFilesAreNotGenerated() {
+        String content = "<?xml version=\"1.0\"?>\n<configuration>\n</configuration>";
+
+        assertFalse(matches(conventions.getGeneratedFilesConventions(), "config/settings.xml", content));
+    }
+
+    @Test
+    public void generatedJavaScriptFilesAreGenerated() {
+        String content = "// Generated by some-tool\nvar x = 1;";
+
+        assertTrue(matches(conventions.getGeneratedFilesConventions(), "src/app.js", content));
+    }
+
+    @Test
+    public void handWrittenJavaScriptFilesAreNotGenerated() {
+        String content = "var x = 1;";
+
+        assertFalse(matches(conventions.getGeneratedFilesConventions(), "src/app.js", content));
+    }
+
+    @Test
+    public void gradleJavaScriptScriptsAreBuildAndDeployment() {
+        assertTrue(matches(conventions.getBuildAndDeploymentFilesConventions(), "tools/build-gradle.js", ""));
+        assertTrue(matches(conventions.getBuildAndDeploymentFilesConventions(), "tools/.-gradle.js", ""));
+        assertFalse(matches(conventions.getBuildAndDeploymentFilesConventions(), "tools/build.js", ""));
+    }
+
+    @Test
+    public void buildGradleFilesStillBuildAndDeployment() {
+        assertTrue(matches(conventions.getBuildAndDeploymentFilesConventions(), "app/build.gradle", ""));
+    }
+}
