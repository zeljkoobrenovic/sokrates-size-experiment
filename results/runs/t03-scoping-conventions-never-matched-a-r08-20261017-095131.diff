@@ -0,0 +1,61 @@
+/*
+ * Copyright (c) 2021 Željko Obrenović. All rights reserved.
+ */
+
+package nl.obren.sokrates.sourcecode.scoping;
+
+import nl.obren.sokrates.sourcecode.SourceFile;
+import org.junit.Test;
+
+import java.io.File;
+import java.util.List;
+
+import static junit.framework.TestCase.assertFalse;
+import static junit.framework.TestCase.assertTrue;
+
+public class ScopingConventionsTest {
+    private final ScopingConventions conventions = new ScopingConventions();
+
+    @Test
+    public void generatedHtmlPagesIncludeHtm() {
+        String pkgdown = "<html>\n<!-- Generated by pkgdown: do not edit by hand -->\n</html>";
+        String doxygen = "<html>\n<!-- Generated by Doxygen 1.9 -->\n</html>";
+        String meta = "<html>\n<head>\n<meta name=\"generator\" content=\"tool\" />\n</head>\n</html>";
+
+        assertTrue(isGenerated("docs/index.htm", pkgdown));
+        assertTrue(isGenerated("docs/index.html", doxygen));
+        assertTrue(isGenerated("docs/index.htm", meta));
+        assertTrue(isGenerated("docs/index.xhtml", meta));
+
+        assertFalse(isGenerated("docs/index.htm", "<html><body>Hand written</body></html>"));
+    }
+
+    @Test
+    public void generatedDotNetDocumentationAndJsFilesMatchByName() {
+        assertTrue(isGenerated("bin/MyAssembly.xml", "<?xml version=\"1.0\"?>\n<doc>\n</doc>"));
+        assertTrue(isGenerated("src/app.js", "// Generated by some tool\nvar x = 1;"));
+
+        assertFalse(isGenerated("src/config.xml", "<?xml version=\"1.0\"?>\n<settings/>"));
+        assertFalse(isGenerated("src/app.js", "var x = 1;\nconsole.log(x);"));
+    }
+
+    @Test
+    public void gradleJavaScriptScriptsAreBuildAndDeployment() {
+        assertTrue(isMatching(conventions.getBuildAndDeploymentFilesConventions(), "scripts/build-gradle.js"));
+        assertTrue(isMatching(conventions.getBuildAndDeploymentFilesConventions(), "build.gradle"));
+        assertFalse(isMatching(conventions.getBuildAndDeploymentFilesConventions(), "src/app.js"));
+    }
+
+    private boolean isGenerated(String path, String content) {
+        return isMatching(conventions.getGeneratedFilesConventions(), path, content);
+    }
+
+    private boolean isMatching(List<Convention> list, String path) {
+        return isMatching(list, path, "");
+    }
+
+    private boolean isMatching(List<Convention> list, String path, String content) {
+        SourceFile sourceFile = new SourceFile(new File(path), content);
+        return list.stream().anyMatch(convention -> convention.matches(sourceFile));
+    }
+}
