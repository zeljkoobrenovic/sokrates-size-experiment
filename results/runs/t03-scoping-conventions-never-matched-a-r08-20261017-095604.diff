+ */
+
+package nl.obren.sokrates.sourcecode.scoping;
+
+import nl.obren.sokrates.sourcecode.SourceFile;
+import org.junit.Test;
+
+import java.io.File;
+import java.util.List;
+
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+public class ScopingConventionsTest {
+    private final ScopingConventions conventions = new ScopingConventions();
+
+    private boolean matchesAny(List<Convention> list, String path, String content) {
+        SourceFile sourceFile = new SourceFile(new File(path), content);
+        return list.stream().anyMatch(convention -> convention.matches(sourceFile));
+    }
+
+    @Test
+    public void generatedHtmlPagesWithHtmExtension() {
+        String pkgdown = "<!-- Generated by pkgdown: do not edit by hand -->\n<html></html>";
+        String doxygen = "<html>\n<!-- Generated by Doxygen 1.9 -->\n</html>";
+        String meta = "<html>\n<meta name=\"generator\" content=\"x\">\n</html>";
+
+        assertTrue(matchesAny(conventions.getGeneratedFilesConventions(), "docs/index.htm", pkgdown));
+        assertTrue(matchesAny(conventions.getGeneratedFilesConventions(), "docs/index.htm", doxygen));
+        assertTrue(matchesAny(conventions.getGeneratedFilesConventions(), "docs/index.htm", meta));
+        assertTrue(matchesAny(conventions.getGeneratedFilesConventions(), "docs/index.html", doxygen));
+        assertTrue(matchesAny(conventions.getGeneratedFilesConventions(), "docs/index.xhtml", meta));
+        assertFalse(matchesAny(conventions.getGeneratedFilesConventions(), "docs/index.htm", "<html></html>"));
+    }
+
+    @Test
+    public void dotNetDocumentationXml() {
+        String doc = "<?xml version=\"1.0\"?>\n<doc>\n<assembly><name>MyAssembly</name></assembly>\n</doc>";
+
+        assertTrue(matchesAny(conventions.getGeneratedFilesConventions(), "bin/MyAssembly.xml", doc));
+        assertFalse(matchesAny(conventions.getGeneratedFilesConventions(), "config/settings.xml", "<config/>"));
+    }
+
+    @Test
+    public void generatedJavaScript() {
+        assertTrue(matchesAny(conventions.getGeneratedFilesConventions(), "src/app.js", "// Generated by Foo\nvar a;"));
+        assertFalse(matchesAny(conventions.getGeneratedFilesConventions(), "src/app.js", "var a;"));
+    }
+
+    @Test
+    public void gradleJavaScriptScripts() {
+        List<Convention> list = conventions.getBuildAndDeploymentFilesConventions();
+
+        assertTrue(matchesAny(list, "build-gradle.js", ""));
+        assertTrue(matchesAny(list, "build.gradle", ""));
+        assertFalse(matchesAny(list, "src/app.js", ""));
+    }
+}
