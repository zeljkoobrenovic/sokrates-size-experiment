+ */
+
+package nl.obren.sokrates.sourcecode.scoping;
+
+import nl.obren.sokrates.sourcecode.SourceFile;
+import org.junit.Test;
+
+import java.io.File;
+import java.util.List;
+
+import static junit.framework.TestCase.assertFalse;
+import static junit.framework.TestCase.assertTrue;
+
+public class ScopingConventionsTest {
+    private final ScopingConventions conventions = new ScopingConventions();
+
+    private boolean isGenerated(String path, String... lines) {
+        return matchesAny(conventions.getGeneratedFilesConventions(), path, lines);
+    }
+
+    private boolean isBuildAndDeployment(String path, String... lines) {
+        return matchesAny(conventions.getBuildAndDeploymentFilesConventions(), path, lines);
+    }
+
+    private boolean matchesAny(List<Convention> list, String path, String... lines) {
+        SourceFile sourceFile = new SourceFile(new File(path), String.join("\n", lines));
+        return list.stream().anyMatch(convention -> convention.matches(sourceFile));
+    }
+
+    @Test
+    public void testHtmlGeneratedPagesIncludeHtm() {
+        assertTrue(isGenerated("/root/docs/index.htm", "<html>", "<!-- Generated by pkgdown: do not edit by hand -->"));
+        assertTrue(isGenerated("/root/docs/index.htm", "<html>", "<head>", "<meta name=\"generator\" content=\"Doxygen 1.9\">"));
+        assertTrue(isGenerated("/root/docs/index.htm", "<html>", "<!-- Generated by Doxygen 1.9 -->"));
+        assertTrue(isGenerated("/root/docs/index.html", "<!-- Generated by Doxygen 1.9 -->"));
+        assertTrue(isGenerated("/root/docs/index.xhtml", "<head>", "<meta name=\"generator\" content=\"tool\">"));
+    }
+
+    @Test
+    public void testHandWrittenHtmlIsNotGenerated() {
+        assertFalse(isGenerated("/root/docs/index.htm", "<html>", "<body>Hello</body>"));
+        assertFalse(isGenerated("/root/docs/index.html", "<html>", "<body>Hello</body>"));
+    }
+
+    @Test
+    public void testDotNetDocumentationXmlIsGenerated() {
+        assertTrue(isGenerated("/root/bin/MyAssembly.xml", "<?xml version=\"1.0\"?>", "<doc>"));
+    }
+
+    @Test
+    public void testHandWrittenXmlIsNotGenerated() {
+        assertFalse(isGenerated("/root/config/settings.xml", "<?xml version=\"1.0\"?>", "<settings>"));
+    }
+
+    @Test
+    public void testGeneratedJavaScriptIsGenerated() {
+        assertTrue(isGenerated("/root/web/app.js", "// Generated by CoffeeScript 1.9"));
+    }
+
+    @Test
+    public void testHandWrittenJavaScriptIsNotGenerated() {
+        assertFalse(isGenerated("/root/web/app.js", "// Application entry point", "var a = 1;"));
+    }
+
+    @Test
+    public void testGradleJavaScriptIsBuildAndDeployment() {
+        assertTrue(isBuildAndDeployment("/root/build-gradle.js"));
+        assertTrue(isBuildAndDeployment("/root/build.gradle"));
+    }
+}
