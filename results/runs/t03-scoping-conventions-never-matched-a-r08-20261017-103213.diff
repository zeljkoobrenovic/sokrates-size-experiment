+ */
+
+package nl.obren.sokrates.sourcecode.scoping;
+
+import nl.obren.sokrates.sourcecode.SourceFile;
+import org.junit.Test;
+
+import java.io.File;
+import java.util.List;
+
+import static junit.framework.TestCase.*;
+
+public class ScopingConventionsTest {
+    private static boolean matchesAny(List<Convention> conventions, String path, String content) {
+        SourceFile sourceFile = new SourceFile(new File(path), content);
+        return conventions.stream().anyMatch(convention -> convention.matches(sourceFile));
+    }
+
+    @Test
+    public void testGeneratedHtmlPages() {
+        List<Convention> generated = new ScopingConventions().getGeneratedFilesConventions();
+
+        String pkgdown = "<!-- Generated by pkgdown: do not edit by hand -->\n<html></html>";
+        String doxygen = "<html>\n<!-- Generated by Doxygen 1.9 -->\n</html>";
+        String meta = "<html>\n<head>\n<meta name=\"generator\" content=\"tool\" />\n</head>\n</html>";
+
+        assertTrue(matchesAny(generated, "docs/index.htm", pkgdown));
+        assertTrue(matchesAny(generated, "docs/index.html", pkgdown));
+        assertTrue(matchesAny(generated, "docs/index.htm", doxygen));
+        assertTrue(matchesAny(generated, "docs/index.html", doxygen));
+        assertTrue(matchesAny(generated, "docs/index.xhtml", meta));
+        assertTrue(matchesAny(generated, "docs/index.htm", meta));
+
+        assertFalse(matchesAny(generated, "docs/index.htm", "<html><body>Hand written</body></html>"));
+    }
+
+    @Test
+    public void testGeneratedDotNetDocumentationAndJavaScript() {
+        List<Convention> generated = new ScopingConventions().getGeneratedFilesConventions();
+
+        assertTrue(matchesAny(generated, "bin/MyAssembly.xml", "<?xml version=\"1.0\"?>\n<doc>\n</doc>"));
+        assertTrue(matchesAny(generated, "src/app.js", "// Generated by some tool\nvar a = 1;"));
+
+        assertFalse(matchesAny(generated, "src/config.xml", "<?xml version=\"1.0\"?>\n<config/>"));
+        assertFalse(matchesAny(generated, "src/app.js", "var a = 1;\nconsole.log(a);"));
+    }
+
+    @Test
+    public void testGradleJavaScriptBuildFiles() {
+        List<Convention> buildAndDeployment = new ScopingConventions().getBuildAndDeploymentFilesConventions();
+
+        assertTrue(matchesAny(buildAndDeployment, "scripts/build-gradle.js", ""));
+        assertTrue(matchesAny(buildAndDeployment, "build.gradle", ""));
+        assertFalse(matchesAny(buildAndDeployment, "src/app.js", ""));
+    }
+}
