+ */
+
+package nl.obren.sokrates.sourcecode.scoping;
+
+import nl.obren.sokrates.sourcecode.SourceFile;
+import org.junit.Test;
+
+import java.io.File;
+import java.util.List;
+
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+public class ScopingConventionsTest {
+    private final ScopingConventions conventions = new ScopingConventions();
+
+    private boolean matches(List<Convention> list, String path, String... lines) {
+        SourceFile sourceFile = new SourceFile(new File(path), String.join("\n", lines));
+        return list.stream().anyMatch(convention -> convention.matches(sourceFile));
+    }
+
+    private boolean generated(String path, String... lines) {
+        return matches(conventions.getGeneratedFilesConventions(), path, lines);
+    }
+
+    private boolean buildAndDeployment(String path, String... lines) {
+        return matches(conventions.getBuildAndDeploymentFilesConventions(), path, lines);
+    }
+
+    @Test
+    public void pkgdownHtmlPagesAreGenerated() {
+        String pkgdown = "<!-- Generated by pkgdown: do not edit by hand -->";
+        assertTrue(generated("docs/index.htm", pkgdown));
+        assertTrue(generated("docs/index.html", pkgdown));
+        assertTrue(generated("docs/index.xhtml", pkgdown));
+    }
+
+    @Test
+    public void doxygenHtmlPagesAreGenerated() {
+        String doxygen = "<!-- Generated by Doxygen 1.9.1 -->";
+        assertTrue(generated("docs/page.htm", doxygen));
+        assertTrue(generated("docs/page.html", doxygen));
+    }
+
+    @Test
+    public void metaGeneratorHtmlPagesAreGenerated() {
+        String meta = "<meta name=\"generator\" content=\"Hugo 0.80\" />";
+        assertTrue(generated("site/index.htm", meta));
+        assertTrue(generated("site/index.html", meta));
+        assertTrue(generated("site/index.xhtml", meta));
+    }
+
+    @Test
+    public void handWrittenHtmlPagesAreNotGenerated() {
+        String html = "<html><body>Hello</body></html>";
+        assertFalse(generated("site/index.htm", html));
+        assertFalse(generated("site/index.html", html));
+    }
+
+    @Test
+    public void dotNetDocumentationXmlIsGenerated() {
+        assertTrue(generated("bin/MyAssembly.xml", "<doc>", "  <assembly>"));
+        assertTrue(generated("bin/MyAssembly.xml", "<?xml version=\"1.0\"?>", "<doc>"));
+    }
+
+    @Test
+    public void handWrittenXmlIsNotGenerated() {
+        assertFalse(generated("config/settings.xml", "<settings>", "  <item/>", "<doc>"));
+        assertFalse(generated("config/settings.xml", "<settings>", "</settings>"));
+    }
+
+    @Test
+    public void generatedJavaScriptIsGenerated() {
+        assertTrue(generated("dist/app.js", "// Generated by some-tool"));
+        assertTrue(generated("app.js", "// Generated by some-tool"));
+    }
+
+    @Test
+    public void handWrittenJavaScriptIsNotGenerated() {
+        assertFalse(generated("src/app.js", "// hand written code"));
+    }
+
+    @Test
+    public void gradleScriptsAreBuildAndDeployment() {
+        assertTrue(buildAndDeployment("build.gradle"));
+        assertTrue(buildAndDeployment("build-gradle.js"));
+        assertTrue(buildAndDeployment("tools/.-gradle.js"));
+    }
+
+    @Test
+    public void otherJavaScriptIsNotBuildAndDeployment() {
+        assertFalse(buildAndDeployment("src/build.js"));
+        assertFalse(buildAndDeployment("src/app.js"));
+    }
+}
