+ */
+
+package nl.obren.sokrates.sourcecode.scoping;
+
+import nl.obren.sokrates.sourcecode.SourceFile;
+import nl.obren.sokrates.sourcecode.SourceFileFilter;
+import nl.obren.sokrates.sourcecode.core.CodeConfiguration;
+import org.junit.Test;
+
+import java.io.File;
+import java.util.Collections;
+import java.util.List;
+import java.util.stream.Collectors;
+
+import static junit.framework.TestCase.assertEquals;
+import static junit.framework.TestCase.assertTrue;
+import static junit.framework.TestCase.assertFalse;
+
+public class ScopingConventionsTest {
+    private CodeConfiguration classify(String path, String content) {
+        CodeConfiguration codeConfiguration = new CodeConfiguration();
+        new ScopingConventions().addConventions(codeConfiguration,
+                Collections.singletonList(new SourceFile(new File(path), content)));
+        return codeConfiguration;
+    }
+
+    private List<String> notes(List<SourceFileFilter> filters) {
+        return filters.stream().map(SourceFileFilter::getNote).collect(Collectors.toList());
+    }
+
+    @Test
+    public void generatedHtmlPagesIncludingHtm() {
+        assertTrue(notes(classify("/root/site/index.htm", "<p>Generated by pkgdown: do not edit by hand</p>\n").getGenerated().getSourceFileFilters())
+                .contains("A generated HTML source file"));
+        assertTrue(notes(classify("/root/doc/page.htm", "<p>Generated by Doxygen 1.9</p>\n").getGenerated().getSourceFileFilters())
+                .contains("A generated HTML source file"));
+        assertTrue(notes(classify("/root/doc/page.htm", "<meta name=\"generator\" content=\"x\"/>\n").getGenerated().getSourceFileFilters())
+                .contains("A generated HTML source file"));
+        assertTrue(notes(classify("/root/doc/page.html", "<p>Generated by Doxygen 1.9</p>\n").getGenerated().getSourceFileFilters())
+                .contains("A generated HTML source file"));
+        assertTrue(notes(classify("/root/doc/page.xhtml", "<meta name=\"generator\" content=\"x\"/>\n").getGenerated().getSourceFileFilters())
+                .contains("A generated HTML source file"));
+    }
+
+    @Test
+    public void handWrittenHtmlStaysOutOfGenerated() {
+        assertEquals(0, classify("/root/site/index.htm", "<html>\n<body>hi</body>\n").getGenerated().getSourceFileFilters().size());
+    }
+
+    @Test
+    public void dotNetDocAndJsGeneratedFiles() {
+        assertTrue(notes(classify("/root/bin/MyAssembly.xml", "<?xml version=\"1.0\"?>\n<doc>\n").getGenerated().getSourceFileFilters())
+                .contains("A generated documentation file for a .NET assembly"));
+        assertTrue(notes(classify("/root/web/app.js", "// Generated by Some Tool\nvar a = 1;\n").getGenerated().getSourceFileFilters())
+                .contains("JS generated"));
+        assertEquals(0, classify("/root/config/settings.xml", "<settings>\n</settings>\n").getGenerated().getSourceFileFilters().size());
+        assertEquals(0, classify("/root/web/app.js", "var a = 1;\n").getGenerated().getSourceFileFilters().size());
+    }
+
+    @Test
+    public void gradleJavaScriptScripts() {
+        assertTrue(notes(classify("/root/build-gradle.js", "").getBuildAndDeployment().getSourceFileFilters())
+                .contains("Gradle configuration"));
+        assertTrue(notes(classify("/root/build.gradle", "").getBuildAndDeployment().getSourceFileFilters())
+                .contains("Gradle configuration"));
+        assertFalse(notes(classify("/root/web/app.js", "var a = 1;\n").getBuildAndDeployment().getSourceFileFilters())
+                .contains("Gradle configuration"));
+    }
+}
