+ */
+
+package nl.obren.sokrates.sourcecode.scoping;
+
+import nl.obren.sokrates.sourcecode.SourceFile;
+import org.junit.Test;
+
+import java.io.File;
+import java.util.List;
+
+import static junit.framework.TestCase.assertFalse;
+import static junit.framework.TestCase.assertTrue;
+
+public class ScopingConventionsTest {
+    private final ScopingConventions conventions = new ScopingConventions();
+
+    private boolean matchesAny(List<Convention> conventions, String path, String content) {
+        SourceFile sourceFile = new SourceFile(new File(path), content);
+        return conventions.stream().anyMatch(convention -> convention.matches(sourceFile));
+    }
+
+    @Test
+    public void testGeneratedHtmlPages() {
+        String pkgdown = "<!-- Generated by pkgdown: do not edit by hand -->\n<html></html>";
+        String doxygen = "<html>\n<!-- Generated by Doxygen 1.9 -->\n</html>";
+        String generator = "<html>\n<head>\n<meta name=\"generator\" content=\"Foo 1.0\">\n</head>\n</html>";
+
+        assertTrue(matchesAny(conventions.getGeneratedFilesConventions(), "docs/index.htm", pkgdown));
+        assertTrue(matchesAny(conventions.getGeneratedFilesConventions(), "docs/index.htm", doxygen));
+        assertTrue(matchesAny(conventions.getGeneratedFilesConventions(), "docs/index.htm", generator));
+
+        assertTrue(matchesAny(conventions.getGeneratedFilesConventions(), "docs/index.html", doxygen));
+        assertTrue(matchesAny(conventions.getGeneratedFilesConventions(), "docs/index.xhtml", generator));
+    }
+
+    @Test
+    public void testHandWrittenHtmlPagesAreNotGenerated() {
+        String handWritten = "<html>\n<head>\n<title>Page</title>\n</head>\n</html>";
+
+        assertFalse(matchesAny(conventions.getGeneratedFilesConventions(), "docs/index.htm", handWritten));
+        assertFalse(matchesAny(conventions.getGeneratedFilesConventions(), "docs/index.html", handWritten));
+    }
+
+    @Test
+    public void testDotNetDocumentationXml() {
+        String content = "<?xml version=\"1.0\"?>\n<doc>\n<assembly>\n</assembly>\n</doc>";
+
+        assertTrue(matchesAny(conventions.getGeneratedFilesConventions(), "src/bin/MyAssembly.xml", content));
+        assertFalse(matchesAny(conventions.getGeneratedFilesConventions(), "src/config/settings.xml", "<settings/>"));
+    }
+
+    @Test
+    public void testGeneratedJavaScript() {
+        String content = "// Generated by CoffeeScript 1.12\nvar a = 1;";
+
+        assertTrue(matchesAny(conventions.getGeneratedFilesConventions(), "src/app.js", content));
+        assertFalse(matchesAny(conventions.getGeneratedFilesConventions(), "src/app.js", "var a = 1;"));
+    }
+
+    @Test
+    public void testGradleJavaScriptIsBuildAndDeployment() {
+        assertTrue(matchesAny(conventions.getBuildAndDeploymentFilesConventions(), "build-gradle.js", ""));
+        assertTrue(matchesAny(conventions.getBuildAndDeploymentFilesConventions(), "build.gradle", ""));
+        assertFalse(matchesAny(conventions.getBuildAndDeploymentFilesConventions(), "src/app.js", ""));
+    }
+}
