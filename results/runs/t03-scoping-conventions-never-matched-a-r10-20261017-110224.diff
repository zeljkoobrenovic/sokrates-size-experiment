+ */
+
+package nl.obren.sokrates.sourcecode.scoping;
+
+import nl.obren.sokrates.sourcecode.SourceFile;
+import org.junit.jupiter.api.Test;
+
+import java.io.File;
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+public class ScopingConventionsTest {
+    private final ScopingConventions conventions = new ScopingConventions();
+
+    private boolean matchesWithNote(List<Convention> list, String note, String path, String... lines) {
+        SourceFile sourceFile = new SourceFile(new File(path), String.join("\n", lines));
+        return list.stream()
+                .filter(convention -> note.equals(convention.getNote()))
+                .anyMatch(convention -> convention.matches(sourceFile));
+    }
+
+    private boolean isGenerated(String path, String... lines) {
+        return matchesWithNote(conventions.getGeneratedFilesConventions(), "A generated HTML source file", path, lines)
+                || matchesWithNote(conventions.getGeneratedFilesConventions(), "A generated documentation file for a .NET assembly", path, lines)
+                || matchesWithNote(conventions.getGeneratedFilesConventions(), "JS generated", path, lines);
+    }
+
+    @Test
+    public void testGeneratedHtmlPagesIncludeHtmAndHtml() {
+        assertTrue(isGenerated("/root/docs/index.htm", "<html>", "<!-- Generated by pkgdown: do not edit by hand -->"));
+        assertTrue(isGenerated("/root/docs/index.htm", "<html>", "<p>x</p>", "<meta name=\"generator\" content=\"Doc\">"));
+        assertTrue(isGenerated("/root/docs/index.htm", "<html>", "<!-- Generated by Doxygen 1.9 -->"));
+        assertTrue(isGenerated("/root/docs/index.html", "<html>", "<!-- Generated by Doxygen 1.9 -->"));
+        assertTrue(isGenerated("/root/docs/index.xhtml", "<html>", "<meta name=\"generator\" content=\"Doc\">"));
+        assertFalse(isGenerated("/root/docs/hand.htm", "<html>", "<p>hand written</p>"));
+    }
+
+    @Test
+    public void testDotNetDocumentationFiles() {
+        assertTrue(isGenerated("/root/MyAssembly.xml", "<?xml version=\"1.0\"?>", "<doc>"));
+        assertTrue(isGenerated("/root/.xml", "<?xml version=\"1.0\"?>", "<doc>"));
+        assertFalse(isGenerated("/root/config.xml", "<?xml version=\"1.0\"?>", "<config/>"));
+    }
+
+    @Test
+    public void testGeneratedJavaScriptFiles() {
+        assertTrue(isGenerated("/root/app.js", "// Generated by Tool", "var a = 1;"));
+        assertFalse(isGenerated("/root/app.js", "var a = 1;", "// Generated by Tool"));
+        assertFalse(isGenerated("/root/hand.js", "var a = 1;"));
+    }
+
+    @Test
+    public void testGradleJavaScriptBuildFiles() {
+        String note = "Gradle configuration";
+        assertTrue(matchesWithNote(conventions.getBuildAndDeploymentFilesConventions(), note, "/root/build-gradle.js"));
+        assertTrue(matchesWithNote(conventions.getBuildAndDeploymentFilesConventions(), note, "/root/.-gradle.js"));
+        assertTrue(matchesWithNote(conventions.getBuildAndDeploymentFilesConventions(), note, "/root/build.gradle"));
+        assertFalse(matchesWithNote(conventions.getBuildAndDeploymentFilesConventions(), note, "/root/app.js"));
+    }
+}
