+ */
+
+package nl.obren.sokrates.sourcecode.scoping;
+
+import nl.obren.sokrates.sourcecode.SourceFile;
+import org.junit.jupiter.api.Test;
+
+import java.io.File;
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+class ScopingConventionsTest {
+    private final ScopingConventions conventions = new ScopingConventions();
+
+    @Test
+    void htmlGeneratorPagesWithHtmExtensionAreGenerated() {
+        assertTrue(isGenerated("docs/index.htm", "<html>\n<!-- Generated by pkgdown: do not edit by hand -->"));
+        assertTrue(isGenerated("docs/index.htm", "<html>\n<head>\n<!-- Generated by Doxygen 1.9 -->"));
+        assertTrue(isGenerated("docs/index.htm", "<head>\n<meta name=\"generator\" content=\"Doxygen\">"));
+        assertTrue(isGenerated("docs/index.html", "<head>\n<!-- Generated by Doxygen 1.9 -->"));
+        assertTrue(isGenerated("docs/index.xhtml", "<head>\n<meta name=\"generator\" content=\"Doxygen\">"));
+    }
+
+    @Test
+    void handWrittenHtmlPagesAreNotGenerated() {
+        assertFalse(isGenerated("docs/index.htm", "<html>\n<body>hello</body>"));
+    }
+
+    @Test
+    void dotNetDocumentationXmlIsGenerated() {
+        assertTrue(isGenerated("bin/MyAssembly.xml", "<?xml version=\"1.0\"?>\n<doc>"));
+    }
+
+    @Test
+    void handWrittenXmlIsNotGenerated() {
+        assertFalse(isGenerated("config/settings.xml", "<?xml version=\"1.0\"?>\n<settings>"));
+    }
+
+    @Test
+    void javaScriptWithGeneratedCommentIsGenerated() {
+        assertTrue(isGenerated("src/app.js", "// Generated by some tool\nvar a = 1;"));
+    }
+
+    @Test
+    void handWrittenJavaScriptIsNotGenerated() {
+        assertFalse(isGenerated("src/app.js", "// hand written\nvar a = 1;"));
+    }
+
+    @Test
+    void gradleJavaScriptIsBuildAndDeployment() {
+        assertTrue(isBuildAndDeployment("scripts/build-gradle.js"));
+        assertTrue(isBuildAndDeployment("build.gradle"));
+        assertFalse(isBuildAndDeployment("src/app.js"));
+    }
+
+    private boolean isGenerated(String path, String content) {
+        return matchesAny(conventions.getGeneratedFilesConventions(), path, content);
+    }
+
+    private boolean isBuildAndDeployment(String path) {
+        return matchesAny(conventions.getBuildAndDeploymentFilesConventions(), path, "");
+    }
+
+    private boolean matchesAny(List<Convention> list, String path, String content) {
+        SourceFile sourceFile = new SourceFile(new File(path), content);
+        return list.stream().anyMatch(convention -> convention.matches(sourceFile));
+    }
+}
