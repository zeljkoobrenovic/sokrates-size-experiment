+ */
+
+package nl.obren.sokrates.sourcecode.scoping;
+
+import org.junit.Test;
+
+import static junit.framework.TestCase.assertFalse;
+import static junit.framework.TestCase.assertTrue;
+
+public class ScopingConventionsTest {
+    private boolean isTestFile(String path) {
+        return new ScopingConventions().getTestFilesConventions().stream()
+                .anyMatch(convention -> convention.pathMatches(path));
+    }
+
+    @Test
+    public void testMockFoldersAreTestResources() {
+        assertTrue(isTestFile("/src/main/java/org/x/mock/Helper.java"));
+        assertTrue(isTestFile("/src/mock.data/Helper.java"));
+        assertTrue(isTestFile("/src/mock(old)/Helper.java"));
+        assertTrue(isTestFile("/src/mock-größe/Helper.java"));
+        assertTrue(isTestFile("/src/mock模拟/Helper.java"));
+        assertTrue(isTestFile("/src/mocks/Helper.java"));
+        assertTrue(isTestFile("/src/__mocks__/Helper.java"));
+        assertTrue(isTestFile("/src/mock-data/Helper.java"));
+        assertTrue(isTestFile("/src/mock_data/Helper.java"));
+        assertTrue(isTestFile("/src/mock data/Helper.java"));
+        assertTrue(isTestFile("/src/mockStore/Helper.java"));
+        assertTrue(isTestFile("C:\\src\\mock\\Helper.java"));
+    }
+
+    @Test
+    public void testOnlyWholeMockFolderNamesAreTestResources() {
+        assertFalse(isTestFile("/src/remock/Helper.java"));
+        assertFalse(isTestFile("/src/demo/Helper.java"));
+        assertFalse(isTestFile("/src/main/java/Helper.java"));
+        assertFalse(isTestFile("/src/main/java/mock.java"));
+        assertFalse(isTestFile("/src/main/java/mockery.java"));
+    }
+}
