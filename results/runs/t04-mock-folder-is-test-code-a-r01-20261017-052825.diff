+
+package nl.obren.sokrates.sourcecode.scoping;
+
+import org.junit.jupiter.api.Test;
+
+import java.lang.reflect.Field;
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+public class ScopingConventionsMockTest {
+
+    @SuppressWarnings("unchecked")
+    private boolean isTestFile(String path) throws Exception {
+        Field field = ScopingConventions.class.getDeclaredField("testFilesConventions");
+        field.setAccessible(true);
+        List<Convention> conventions = (List<Convention>) field.get(new ScopingConventions());
+        return conventions.stream().anyMatch(convention -> convention.pathMatches(path));
+    }
+
+    @Test
+    public void mockFoldersAreTestCode() throws Exception {
+        assertTrue(isTestFile("x-pack/plugin/inference/qa/test-service-plugin/src/main/java/org/elasticsearch/xpack/inference/mock/TestService.java"));
+        assertTrue(isTestFile("src/mock.data/a.json"));
+        assertTrue(isTestFile("src/mock(old)/a.json"));
+        assertTrue(isTestFile("src/mock-größe/a.json"));
+        assertTrue(isTestFile("src/mock模拟/a.json"));
+        assertTrue(isTestFile("src\\mock\\a.java"));
+        assertTrue(isTestFile("src/__mocks__/a.js"));
+        assertTrue(isTestFile("src/__mock/a.js"));
+    }
+
+    @Test
+    public void previouslyMatchedMockFoldersStillAreTestCode() throws Exception {
+        assertTrue(isTestFile("src/mocks/a.js"));
+        assertTrue(isTestFile("src/mock-data/a.json"));
+        assertTrue(isTestFile("src/mock_data/a.json"));
+        assertTrue(isTestFile("src/mock data/a.json"));
+        assertTrue(isTestFile("src/mockStore/a.js"));
+    }
+
+    @Test
+    public void matchStaysWithinFolderName() throws Exception {
+        assertFalse(isTestFile("src/remock/a.java"));
+        assertFalse(isTestFile("src/demo/a.java"));
+        assertFalse(isTestFile("src/main/java/a.java"));
+        assertFalse(isTestFile("src/mock.java"));
+        assertFalse(isTestFile("src/mockery.java"));
+    }
+}
