+ */
+
+package nl.obren.sokrates.sourcecode.scoping;
+
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+public class ScopingConventionsTest {
+    private boolean isTestPath(String path) {
+        return new ScopingConventions().getTestFilesConventions().stream()
+                .anyMatch(convention -> convention.pathMatches(path));
+    }
+
+    @Test
+    public void mockFoldersAreTestCode() {
+        assertTrue(isTestPath("/root/x-pack/plugin/inference/qa/test-service-plugin/src/main/java/org/elasticsearch/xpack/inference/mock/MockFile.java"));
+        assertTrue(isTestPath("/root/src/mock.data/a.json"));
+        assertTrue(isTestPath("/root/src/mock(old)/a.json"));
+        assertTrue(isTestPath("/root/src/mock-größe/a.json"));
+        assertTrue(isTestPath("/root/src/mock模拟/a.json"));
+        assertTrue(isTestPath("C:\\root\\src\\mock\\a.json"));
+        assertTrue(isTestPath("/root/src/__mocks__/a.js"));
+        assertTrue(isTestPath("/root/src/mocks/a.js"));
+        assertTrue(isTestPath("/root/src/mock-data/a.json"));
+        assertTrue(isTestPath("/root/src/mock data/a.json"));
+        assertTrue(isTestPath("/root/src/mockStore/a.js"));
+    }
+
+    @Test
+    public void mockMatchesStayWithinFolderName() {
+        assertFalse(isTestPath("/root/src/remock/a.java"));
+        assertFalse(isTestPath("/root/src/demo/a.java"));
+        assertFalse(isTestPath("/root/src/main/java/a.java"));
+        assertFalse(isTestPath("/root/src/main/java/mock.java"));
+        assertFalse(isTestPath("/root/src/main/java/mockery.java"));
+    }
+}
