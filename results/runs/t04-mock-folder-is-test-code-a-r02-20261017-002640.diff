+package nl.obren.sokrates.sourcecode.scoping;
+
+import nl.obren.sokrates.sourcecode.SourceFile;
+import org.junit.jupiter.api.Test;
+
+import java.io.File;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+class MockFolderConventionTest {
+    private boolean isTest(String path) {
+        SourceFile file = new SourceFile(new File(path));
+        return new ScopingConventions().getTestFilesConventions().stream().anyMatch(c -> c.matches(file));
+    }
+
+    @Test
+    void mockFolders() {
+        String[] folders = {"mock", "mocks", "__mocks__", "mock-data", "mock_data", "mock data",
+                "mockStore", "mock.data", "mock(old)", "mock-größe", "mock模拟", "__mock"};
+        for (String folder : folders) {
+            assertEquals(true, isTest("src/main/java/" + folder + "/A.java"), folder);
+            assertEquals(true, isTest("a\\b\\" + folder + "\\c\\A.java"), folder);
+        }
+    }
+
+    @Test
+    void notMockFolders() {
+        String[] paths = {"src/main/java/A.java", "remock/A.java", "demo/A.java", "src/mock.java",
+                "src/mockery.java", "a\\remock\\A.java"};
+        for (String path : paths) {
+            assertEquals(false, isTest(path), path);
+        }
+    }
+}
