+
+package nl.obren.sokrates.sourcecode.scoping;
+
+import org.junit.Test;
+
+import static junit.framework.TestCase.assertFalse;
+import static junit.framework.TestCase.assertTrue;
+
+public class ScopingConventionsTest {
+    private final ScopingConventions conventions = new ScopingConventions();
+
+    private boolean isTestFile(String path) {
+        return conventions.getTestFilesConventions().stream().anyMatch(convention -> convention.pathMatches(path));
+    }
+
+    @Test
+    public void testMockFolderIsTestCode() {
+        assertTrue(isTestFile("/root/src/main/java/org/example/mock/Foo.java"));
+        assertTrue(isTestFile("/root/a/mock.data/x.java"));
+        assertTrue(isTestFile("/root/a/mock(old)/x.java"));
+        assertTrue(isTestFile("/root/a/mock-größe/x.java"));
+        assertTrue(isTestFile("/root/a/mock模拟/x.java"));
+        assertTrue(isTestFile("/root/a/__mock/x.java"));
+        assertTrue(isTestFile("C:\\root\\a\\mock\\x.java"));
+    }
+
+    @Test
+    public void testExistingMockFoldersAreStillTestCode() {
+        assertTrue(isTestFile("/root/a/mocks/x.java"));
+        assertTrue(isTestFile("/root/a/__mocks__/x.java"));
+        assertTrue(isTestFile("/root/a/mock-data/x.java"));
+        assertTrue(isTestFile("/root/a/mock_data/x.java"));
+        assertTrue(isTestFile("/root/a/mock data/x.java"));
+        assertTrue(isTestFile("/root/a/mockStore/x.java"));
+    }
+
+    @Test
+    public void testMatchStaysWithinFolderName() {
+        assertFalse(isTestFile("/root/a/remock/x.java"));
+        assertFalse(isTestFile("/root/demo/x.java"));
+        assertFalse(isTestFile("/root/src/main/java/x.java"));
+        assertFalse(isTestFile("/root/src/mock.java"));
+        assertFalse(isTestFile("/root/src/mockery.java"));
+    }
+}
