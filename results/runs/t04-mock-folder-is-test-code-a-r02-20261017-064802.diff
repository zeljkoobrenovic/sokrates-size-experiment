+ */
+
+package nl.obren.sokrates.sourcecode.scoping;
+
+import org.junit.Test;
+
+import static junit.framework.TestCase.assertFalse;
+import static junit.framework.TestCase.assertTrue;
+
+public class ScopingConventionsTest {
+    private boolean isMockResource(String path) {
+        return new ScopingConventions().getTestFilesConventions().stream()
+                .filter(convention -> convention.getNote().equals("Mock resources"))
+                .anyMatch(convention -> convention.pathMatches(path));
+    }
+
+    @Test
+    public void testMockFoldersAreTestCode() {
+        assertTrue(isMockResource("a/mocks/b.js"));
+        assertTrue(isMockResource("a/__mocks__/b.js"));
+        assertTrue(isMockResource("a/mock-data/b.json"));
+        assertTrue(isMockResource("a/mock_data/b.json"));
+        assertTrue(isMockResource("a/mock data/b.json"));
+        assertTrue(isMockResource("a/mockStore/b.js"));
+        assertTrue(isMockResource("a/mock/b.java"));
+        assertTrue(isMockResource("a/mock.data/b.json"));
+        assertTrue(isMockResource("a/mock(old)/b.json"));
+        assertTrue(isMockResource("a/mock-größe/b.json"));
+        assertTrue(isMockResource("a/mock模拟/b.json"));
+        assertTrue(isMockResource("a/__mock/b.json"));
+        assertTrue(isMockResource("a\\mock\\b.java"));
+    }
+
+    @Test
+    public void testMockMatchesStayWithinFolderName() {
+        assertFalse(isMockResource("a/remock/b.java"));
+        assertFalse(isMockResource("a/demo/b.java"));
+        assertFalse(isMockResource("src/main/java/b.java"));
+        assertFalse(isMockResource("a/mock.java"));
+        assertFalse(isMockResource("a/mockery.java"));
+    }
+}
