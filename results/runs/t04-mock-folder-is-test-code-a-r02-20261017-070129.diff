+
+package nl.obren.sokrates.sourcecode.scoping;
+
+import org.junit.Test;
+
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+public class ScopingConventionsMockTest {
+    private boolean isTestCode(String path) {
+        return new ScopingConventions().getTestFilesConventions().stream()
+                .anyMatch(convention -> convention.pathMatches(path));
+    }
+
+    @Test
+    public void mockFoldersAreTestCode() {
+        assertTrue(isTestCode("x-pack/plugin/inference/qa/test-service-plugin/src/main/java/org/elasticsearch/xpack/inference/mock/TestService.java"));
+        assertTrue(isTestCode("src/mock.data/a.json"));
+        assertTrue(isTestCode("src/mock(old)/a.json"));
+        assertTrue(isTestCode("src/mock-größe/a.json"));
+        assertTrue(isTestCode("src/mock模拟/a.json"));
+        assertTrue(isTestCode("src\\mock\\a.json"));
+        assertTrue(isTestCode("src\\mock.data\\a.json"));
+        assertTrue(isTestCode("src/__mock/a.json"));
+        assertTrue(isTestCode("src/__mock-data/a.json"));
+    }
+
+    @Test
+    public void previouslyRecognizedMockFoldersStayTestCode() {
+        assertTrue(isTestCode("src/mocks/a.js"));
+        assertTrue(isTestCode("src/__mocks__/a.js"));
+        assertTrue(isTestCode("src/mock-data/a.json"));
+        assertTrue(isTestCode("src/mock_data/a.json"));
+        assertTrue(isTestCode("src/mock data/a.json"));
+        assertTrue(isTestCode("src/mockStore/a.js"));
+    }
+
+    @Test
+    public void matchStaysWithinFolderName() {
+        assertFalse(isTestCode("src/remock/a.java"));
+        assertFalse(isTestCode("src/demo/a.java"));
+        assertFalse(isTestCode("src/main/java/a.java"));
+        assertFalse(isTestCode("src/main/java/mock.java"));
+        assertFalse(isTestCode("src/main/java/mockery.java"));
+        assertFalse(isTestCode("src/mock.java"));
+    }
+}
