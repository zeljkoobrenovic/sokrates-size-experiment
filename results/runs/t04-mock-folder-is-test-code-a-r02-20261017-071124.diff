+
+package nl.obren.sokrates.sourcecode.scoping;
+
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+public class ScopingConventionsTest {
+    private boolean isTestConvention(String path) {
+        return new ScopingConventions().getTestFilesConventions().stream()
+                .anyMatch(convention -> convention.pathMatches(path));
+    }
+
+    @Test
+    public void mockFoldersAreTestCode() {
+        assertTrue(isTestConvention("/repo/x-pack/plugin/inference/qa/test-service-plugin/src/main/java/org/elasticsearch/xpack/inference/mock/Service.java"));
+        assertTrue(isTestConvention("/repo/src/mock.data/a.json"));
+        assertTrue(isTestConvention("/repo/src/mock(old)/a.json"));
+        assertTrue(isTestConvention("/repo/src/mock-größe/a.json"));
+        assertTrue(isTestConvention("/repo/src/mock模拟/a.json"));
+        assertTrue(isTestConvention("C:\\repo\\src\\mock\\a.json"));
+        assertTrue(isTestConvention("/repo/src/__mock/a.json"));
+    }
+
+    @Test
+    public void previouslyMatchedMockFoldersAreStillTestCode() {
+        assertTrue(isTestConvention("/repo/src/mocks/a.json"));
+        assertTrue(isTestConvention("/repo/src/__mocks__/a.json"));
+        assertTrue(isTestConvention("/repo/src/mock-data/a.json"));
+        assertTrue(isTestConvention("/repo/src/mock_data/a.json"));
+        assertTrue(isTestConvention("/repo/src/mock data/a.json"));
+        assertTrue(isTestConvention("/repo/src/mockStore/a.json"));
+    }
+
+    @Test
+    public void matchStaysWithinFolderName() {
+        assertFalse(isTestConvention("/repo/src/remock/a.json"));
+        assertFalse(isTestConvention("/repo/src/demo/a.json"));
+        assertFalse(isTestConvention("/repo/src/main/java/A.java"));
+        assertFalse(isTestConvention("/repo/src/main/java/mock.java"));
+        assertFalse(isTestConvention("/repo/src/main/java/mockery.java"));
+    }
+}
