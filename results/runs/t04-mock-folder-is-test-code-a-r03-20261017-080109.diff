+package nl.obren.sokrates.sourcecode.scoping;
+
+import org.junit.Test;
+
+import java.util.List;
+
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+public class ScopingConventionsTest {
+    private final List<Convention> testConventions = new ScopingConventions().getTestFilesConventions();
+
+    private boolean isTest(String path) {
+        return testConventions.stream().anyMatch(convention -> convention.pathMatches(path));
+    }
+
+    @Test
+    public void mockFoldersAreTestCode() {
+        assertTrue(isTest("x-pack/plugin/inference/qa/test-service-plugin/src/main/java/org/elasticsearch/xpack/inference/mock/A.java"));
+        assertTrue(isTest("/a/b/mock.data/x.json"));
+        assertTrue(isTest("/a/b/mock(old)/x.json"));
+        assertTrue(isTest("/a/mock-größe/x.txt"));
+        assertTrue(isTest("/a/mock模拟/x.txt"));
+        assertTrue(isTest("/a/__mock/x.txt"));
+        assertTrue(isTest("C:\\proj\\mock.data\\x.json"));
+        assertTrue(isTest("C:\\proj\\mock\\x.java"));
+    }
+
+    @Test
+    public void existingMockFoldersStayTestCode() {
+        assertTrue(isTest("/a/mocks/x.txt"));
+        assertTrue(isTest("/a/__mocks__/x.js"));
+        assertTrue(isTest("/a/mock-data/x"));
+        assertTrue(isTest("/a/mock_data/x"));
+        assertTrue(isTest("/a/mock data/x"));
+        assertTrue(isTest("/a/mockStore/x"));
+    }
+
+    @Test
+    public void matchIsLimitedToTheFolderName() {
+        assertFalse(isTest("/a/remock/x.java"));
+        assertFalse(isTest("/a/demo/x.java"));
+        assertFalse(isTest("/a/src/main/java/x.java"));
+        assertFalse(isTest("/a/src/mock.java"));
+        assertFalse(isTest("/a/src/mockery.java"));
+        assertFalse(isTest("/a/mock"));
+    }
+}
