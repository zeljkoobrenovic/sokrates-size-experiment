+
+package nl.obren.sokrates.sourcecode.scoping;
+
+import org.junit.Test;
+
+import static junit.framework.TestCase.assertFalse;
+import static junit.framework.TestCase.assertTrue;
+
+public class ScopingConventionsMockTest {
+    private boolean isMockTest(String path) {
+        return new ScopingConventions().getTestFilesConventions().stream()
+                .filter(convention -> "Mock resources".equals(convention.getNote()))
+                .anyMatch(convention -> convention.pathMatches(path));
+    }
+
+    @Test
+    public void testMockFoldersAreTestCode() {
+        assertTrue(isMockTest("x/src/main/java/org/mock/a.java"));
+        assertTrue(isMockTest("x/src/main/java/org/mock/sub/a.java"));
+        assertTrue(isMockTest("x/mock.data/a.json"));
+        assertTrue(isMockTest("x/mock(old)/a.json"));
+        assertTrue(isMockTest("x/mock-größe/a.json"));
+        assertTrue(isMockTest("x/mock模拟/a.json"));
+        assertTrue(isMockTest("x\\mock\\a.java"));
+        assertTrue(isMockTest("mock/a.java"));
+
+        assertTrue(isMockTest("x/mocks/a.js"));
+        assertTrue(isMockTest("x/__mocks__/a.js"));
+        assertTrue(isMockTest("x/__mock/a.js"));
+        assertTrue(isMockTest("x/mock-data/a.json"));
+        assertTrue(isMockTest("x/mock_data/a.json"));
+        assertTrue(isMockTest("x/mock data/a.json"));
+        assertTrue(isMockTest("x/mockStore/a.js"));
+    }
+
+    @Test
+    public void testNonMockPathsAreNotTestCode() {
+        assertFalse(isMockTest("x/remock/a.java"));
+        assertFalse(isMockTest("x/demo/a.java"));
+        assertFalse(isMockTest("x/src/main/java/a.java"));
+        assertFalse(isMockTest("x/src/main/java/mock.java"));
+        assertFalse(isMockTest("x/src/main/java/mockery.java"));
+        assertFalse(isMockTest("x\\remock\\a.java"));
+    }
+}
