+ */
+
+package nl.obren.sokrates.sourcecode.scoping;
+
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+public class ScopingConventionsTest {
+    private final ScopingConventions conventions = new ScopingConventions();
+
+    private boolean isMockResources(String path) {
+        return conventions.getTestFilesConventions().stream()
+                .anyMatch(convention -> convention.getNote().equals("Mock resources") && convention.pathMatches(path));
+    }
+
+    @Test
+    public void testMockFoldersAreTestCode() {
+        assertTrue(isMockResources("/root/src/mock/A.java"));
+        assertTrue(isMockResources("/root/src/mock.data/A.java"));
+        assertTrue(isMockResources("/root/src/mock(old)/A.java"));
+        assertTrue(isMockResources("/root/src/mock-größe/A.java"));
+        assertTrue(isMockResources("/root/src/mock模拟/A.java"));
+        assertTrue(isMockResources("/root/src/mock-data/A.java"));
+        assertTrue(isMockResources("/root/src/mock_data/A.java"));
+        assertTrue(isMockResources("/root/src/mock data/A.java"));
+        assertTrue(isMockResources("/root/src/mockStore/A.java"));
+        assertTrue(isMockResources("/root/src/mocks/A.java"));
+        assertTrue(isMockResources("/root/src/__mocks__/A.js"));
+        assertTrue(isMockResources("/root/src/__mock/A.js"));
+    }
+
+    @Test
+    public void testMockFoldersInWindowsPathsAreTestCode() {
+        assertTrue(isMockResources("C:\\root\\src\\mock\\A.java"));
+        assertTrue(isMockResources("C:\\root\\src\\mock.data\\A.java"));
+    }
+
+    @Test
+    public void testOnlyMockFolderNamesAreTestCode() {
+        assertFalse(isMockResources("/root/src/remock/A.java"));
+        assertFalse(isMockResources("/root/src/demo/A.java"));
+        assertFalse(isMockResources("/root/src/main/java/A.java"));
+        assertFalse(isMockResources("/root/src/mock.java"));
+        assertFalse(isMockResources("/root/src/mockery.java"));
+    }
+}
