+
+package nl.obren.sokrates.sourcecode.scoping;
+
+import nl.obren.sokrates.sourcecode.SourceFileFilter;
+import org.junit.Test;
+
+import java.lang.reflect.Field;
+import java.util.List;
+
+import static junit.framework.TestCase.assertFalse;
+import static junit.framework.TestCase.assertTrue;
+
+public class ScopingConventionsMockFoldersTest {
+    @Test
+    public void mockFoldersAreTestResources() throws Exception {
+        assertTestPath("/root/src/mocks/Data.java");
+        assertTestPath("/root/src/__mocks__/Data.js");
+        assertTestPath("/root/src/mock-data/Data.java");
+        assertTestPath("/root/src/mock_data/Data.java");
+        assertTestPath("/root/src/mock data/Data.java");
+        assertTestPath("/root/src/mockStore/Data.java");
+        assertTestPath("/root/src/mock/Data.java");
+        assertTestPath("/root/src/mock.data/Data.java");
+        assertTestPath("/root/src/mock(old)/Data.java");
+        assertTestPath("/root/src/mock-größe/Data.java");
+        assertTestPath("/root/src/mock模拟/Data.java");
+        assertTestPath("\\root\\src\\mock\\Data.java");
+        assertTestPath("/root/x-pack/plugin/inference/qa/test-service-plugin/src/main/java/org/elasticsearch/xpack/inference/mock/Data.java");
+    }
+
+    @Test
+    public void otherPathsAreNotTestResources() throws Exception {
+        assertFalse(matchesMockConvention("/root/src/remock/Data.java"));
+        assertFalse(matchesMockConvention("/root/src/demo/Data.java"));
+        assertFalse(matchesMockConvention("/root/src/main/java/Data.java"));
+        assertFalse(matchesMockConvention("/root/src/main/java/mock.java"));
+        assertFalse(matchesMockConvention("/root/src/main/java/mockery.java"));
+    }
+
+    private void assertTestPath(String path) throws Exception {
+        assertTrue(path, matchesMockConvention(path));
+    }
+
+    private boolean matchesMockConvention(String path) throws Exception {
+        Field field = ScopingConventions.class.getDeclaredField("testFilesConventions");
+        field.setAccessible(true);
+        List<Convention> conventions = (List<Convention>) field.get(new ScopingConventions());
+        for (Convention convention : conventions) {
+            if ("Mock resources".equals(convention.getNote()) && new SourceFileFilter(convention.getPathPattern(), "").pathMatches(path)) {
+                return true;
+            }
+        }
+        return false;
+    }
+}
