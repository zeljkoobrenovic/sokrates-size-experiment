+package nl.obren.sokrates.sourcecode.scoping;
+
+import nl.obren.sokrates.sourcecode.SourceFile;
+import org.junit.jupiter.api.Test;
+
+import java.io.File;
+import java.util.List;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+public class MockFolderConventionTest {
+    private boolean isTest(String path) {
+        SourceFile file = new SourceFile(new File(path));
+        List<Convention> conventions = new ScopingConventions().getTestFilesConventions();
+        return conventions.stream().anyMatch(c -> c.matches(file));
+    }
+
+    @Test
+    public void mockFolders() {
+        for (String folder : new String[]{"mock", "mocks", "__mocks__", "mock-data", "mock_data", "mock data",
+                "mockStore", "mock.data", "mock(old)", "mock-größe", "mock模拟", "__mock"}) {
+            assertEquals(true, isTest("a/b/" + folder + "/x/F.java"), folder);
+            assertEquals(true, isTest("a\\b\\" + folder + "\\F.java"), folder);
+        }
+    }
+
+    @Test
+    public void notMockFolders() {
+        for (String path : new String[]{"a/remock/F.java", "a/demo/F.java", "a/src/main/java/F.java",
+                "a/mock.java", "a/mockery.java"}) {
+            assertEquals(false, isTest(path), path);
+        }
+    }
+}
