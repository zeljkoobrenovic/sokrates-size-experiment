+ */
+
+package nl.obren.sokrates.sourcecode.scoping;
+
+import org.junit.Test;
+
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+public class ScopingConventionsTest {
+    private boolean isMockTest(String path) {
+        return new ScopingConventions().getTestFilesConventions().stream()
+                .anyMatch(convention -> convention.pathMatches(path));
+    }
+
+    @Test
+    public void mockFolders() {
+        String base = "/repo/x-pack/plugin/inference/qa/test-service-plugin/src/main/java/org/elasticsearch/xpack/inference/";
+        assertTrue(isMockTest(base + "mock/Foo.java"));
+        assertTrue(isMockTest(base + "mock.data/Foo.java"));
+        assertTrue(isMockTest(base + "mock(old)/Foo.java"));
+        assertTrue(isMockTest(base + "mock-größe/Foo.java"));
+        assertTrue(isMockTest(base + "mock模拟/Foo.java"));
+        assertTrue(isMockTest(base + "mocks/Foo.java"));
+        assertTrue(isMockTest(base + "__mocks__/Foo.java"));
+        assertTrue(isMockTest(base + "mock-data/Foo.java"));
+        assertTrue(isMockTest(base + "mock_data/Foo.java"));
+        assertTrue(isMockTest(base + "mock data/Foo.java"));
+        assertTrue(isMockTest(base + "mockStore/Foo.java"));
+        assertTrue(isMockTest("C:\\repo\\src\\mock\\Foo.java"));
+    }
+
+    @Test
+    public void nonMockFiles() {
+        String base = "/repo/src/main/java/";
+        assertFalse(isMockTest(base + "Foo.java"));
+        assertFalse(isMockTest(base + "mock.java"));
+        assertFalse(isMockTest(base + "mockery.java"));
+        assertFalse(isMockTest("/repo/remock/Foo.java"));
+        assertFalse(isMockTest("/repo/demo/Foo.java"));
+    }
+}
