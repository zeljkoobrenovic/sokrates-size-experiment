+
+package nl.obren.sokrates.sourcecode.scoping;
+
+import org.junit.Test;
+
+import static junit.framework.TestCase.assertFalse;
+import static junit.framework.TestCase.assertTrue;
+
+public class ScopingConventionsTest {
+    private boolean isTestFile(String path) {
+        return new ScopingConventions().getTestFilesConventions().stream()
+                .anyMatch(convention -> convention.pathMatches(path));
+    }
+
+    @Test
+    public void mockFoldersAreTestCode() {
+        assertTrue(isTestFile("/repo/x-pack/plugin/inference/qa/test-service-plugin/src/main/java/org/elasticsearch/xpack/inference/mock/Foo.java"));
+        assertTrue(isTestFile("/repo/src/mock.data/a.json"));
+        assertTrue(isTestFile("/repo/src/mock(old)/a.json"));
+        assertTrue(isTestFile("/repo/src/mock-größe/a.json"));
+        assertTrue(isTestFile("/repo/src/mock模拟/a.json"));
+        assertTrue(isTestFile("/repo/src/__mock/a.json"));
+        assertTrue(isTestFile("/repo/src/__mock.x/a.json"));
+        assertTrue(isTestFile("C:\\repo\\src\\mock\\a.json"));
+        assertTrue(isTestFile("C:\\repo\\src\\mock.data\\a.json"));
+    }
+
+    @Test
+    public void previouslyMatchedMockFoldersAreStillTestCode() {
+        assertTrue(isTestFile("/repo/src/mocks/a.java"));
+        assertTrue(isTestFile("/repo/src/__mocks__/a.js"));
+        assertTrue(isTestFile("/repo/src/mock-data/a.json"));
+        assertTrue(isTestFile("/repo/src/mock_data/a.json"));
+        assertTrue(isTestFile("/repo/src/mock data/a.json"));
+        assertTrue(isTestFile("/repo/src/mockStore/a.js"));
+    }
+
+    @Test
+    public void matchStaysWithinFolderName() {
+        assertFalse(isTestFile("/repo/src/remock/a.java"));
+        assertFalse(isTestFile("/repo/src/demo/a.java"));
+        assertFalse(isTestFile("/repo/src/main/java/a.java"));
+        assertFalse(isTestFile("/repo/src/main/java/mock.java"));
+        assertFalse(isTestFile("/repo/src/main/java/mockery.java"));
+    }
+}
