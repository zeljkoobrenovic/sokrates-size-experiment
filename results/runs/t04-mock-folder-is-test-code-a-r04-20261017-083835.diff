+
+package nl.obren.sokrates.sourcecode.scoping;
+
+import org.junit.Test;
+
+import static junit.framework.TestCase.assertFalse;
+import static junit.framework.TestCase.assertTrue;
+
+public class ScopingConventionsMockTest {
+    private boolean isMockResources(String path) {
+        return new ScopingConventions().getTestFilesConventions().stream()
+                .filter(convention -> "Mock resources".equals(convention.getNote()))
+                .anyMatch(convention -> convention.pathMatches(path));
+    }
+
+    @Test
+    public void testMockFolderNamesAreTestCode() {
+        assertTrue(isMockResources("/root/src/mock/Service.java"));
+        assertTrue(isMockResources("/root/src/mock.data/Service.java"));
+        assertTrue(isMockResources("/root/src/mock(old)/Service.java"));
+        assertTrue(isMockResources("/root/src/mock-größe/Service.java"));
+        assertTrue(isMockResources("/root/src/mock模拟/Service.java"));
+        assertTrue(isMockResources("/root/src/__mock/Service.java"));
+        assertTrue(isMockResources("\\root\\src\\mock\\Service.java"));
+        assertTrue(isMockResources("/root/src/x-pack/plugin/inference/qa/test-service-plugin/src/main/java/org/elasticsearch/xpack/inference/mock/Service.java"));
+    }
+
+    @Test
+    public void testExistingMockFolderNamesStillAreTestCode() {
+        assertTrue(isMockResources("/root/src/mocks/Service.java"));
+        assertTrue(isMockResources("/root/src/__mocks__/Service.java"));
+        assertTrue(isMockResources("/root/src/mock-data/Service.java"));
+        assertTrue(isMockResources("/root/src/mock_data/Service.java"));
+        assertTrue(isMockResources("/root/src/mock data/Service.java"));
+        assertTrue(isMockResources("/root/src/mockStore/Service.java"));
+    }
+
+    @Test
+    public void testOnlyWholeFolderNamesMatch() {
+        assertFalse(isMockResources("/root/src/remock/Service.java"));
+        assertFalse(isMockResources("/root/src/demo/Service.java"));
+        assertFalse(isMockResources("/root/src/main/java/Service.java"));
+        assertFalse(isMockResources("/root/src/mock.java"));
+        assertFalse(isMockResources("/root/src/mockery.java"));
+    }
+}
