+ */
+
+package nl.obren.sokrates.sourcecode.scoping;
+
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+public class ScopingConventionsTest {
+    private boolean isMockResource(String path) {
+        return new ScopingConventions().getTestFilesConventions().stream()
+                .filter(convention -> "Mock resources".equals(convention.getNote()))
+                .anyMatch(convention -> convention.pathMatches(path));
+    }
+
+    @Test
+    public void testMockFoldersAreTestCode() {
+        assertTrue(isMockResource("/root/src/mock/Data.java"));
+        assertTrue(isMockResource("/root/src/mock.data/Data.java"));
+        assertTrue(isMockResource("/root/src/mock(old)/Data.java"));
+        assertTrue(isMockResource("/root/src/mock-größe/Data.java"));
+        assertTrue(isMockResource("/root/src/mock模拟/Data.java"));
+        assertTrue(isMockResource("/root/src/__mock/Data.java"));
+        assertTrue(isMockResource("\\root\\src\\mock\\Data.java"));
+        assertTrue(isMockResource("/root/x-pack/plugin/inference/qa/test-service-plugin/src/main/java/org/elasticsearch/xpack/inference/mock/Service.java"));
+
+        assertTrue(isMockResource("/root/src/mocks/Data.java"));
+        assertTrue(isMockResource("/root/src/__mocks__/Data.java"));
+        assertTrue(isMockResource("/root/src/mock-data/Data.java"));
+        assertTrue(isMockResource("/root/src/mock_data/Data.java"));
+        assertTrue(isMockResource("/root/src/mock data/Data.java"));
+        assertTrue(isMockResource("/root/src/mockStore/Data.java"));
+    }
+
+    @Test
+    public void testNonMockPathsAreNotTestCode() {
+        assertFalse(isMockResource("/root/src/remock/Data.java"));
+        assertFalse(isMockResource("/root/src/demo/Data.java"));
+        assertFalse(isMockResource("/root/src/main/java/Data.java"));
+        assertFalse(isMockResource("/root/src/mock.java"));
+        assertFalse(isMockResource("/root/src/mockery.java"));
+    }
+}
