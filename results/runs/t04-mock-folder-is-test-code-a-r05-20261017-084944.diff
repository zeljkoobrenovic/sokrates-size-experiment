+
+package nl.obren.sokrates.sourcecode.scoping;
+
+import nl.obren.sokrates.sourcecode.SourceFileFilter;
+import org.junit.Test;
+
+import static junit.framework.TestCase.assertFalse;
+import static junit.framework.TestCase.assertTrue;
+
+public class ScopingConventionsTest {
+    private boolean isMockResources(String path) {
+        return new ScopingConventions().getTestFilesConventions().stream()
+                .filter(convention -> "Mock resources".equals(convention.getNote()))
+                .anyMatch(convention -> new SourceFileFilter(convention.getPathPattern(), "").pathMatches(path));
+    }
+
+    @Test
+    public void testMockFoldersAreMockResources() {
+        assertTrue(isMockResources("/root/x-pack/inference/mock/Service.java"));
+        assertTrue(isMockResources("/root/src/mock.data/a.json"));
+        assertTrue(isMockResources("/root/src/mock(old)/a.json"));
+        assertTrue(isMockResources("/root/src/mock-größe/a.json"));
+        assertTrue(isMockResources("/root/src/mock模拟/a.json"));
+        assertTrue(isMockResources("\\root\\src\\mock\\a.java"));
+        assertTrue(isMockResources("/root/src/mocks/a.json"));
+        assertTrue(isMockResources("/root/src/__mocks__/a.js"));
+        assertTrue(isMockResources("/root/src/__mock/a.js"));
+        assertTrue(isMockResources("/root/src/mock-data/a.json"));
+        assertTrue(isMockResources("/root/src/mock_data/a.json"));
+        assertTrue(isMockResources("/root/src/mock data/a.json"));
+        assertTrue(isMockResources("/root/src/mockStore/a.js"));
+    }
+
+    @Test
+    public void testOtherPathsAreNotMockResources() {
+        assertFalse(isMockResources("/root/src/remock/a.java"));
+        assertFalse(isMockResources("/root/src/demo/a.java"));
+        assertFalse(isMockResources("/root/src/main/java/a.java"));
+        assertFalse(isMockResources("/root/src/mock.java"));
+        assertFalse(isMockResources("/root/src/mockery.java"));
+    }
+}
