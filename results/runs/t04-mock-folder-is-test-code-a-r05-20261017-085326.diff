+
+package nl.obren.sokrates.sourcecode.scoping;
+
+import org.junit.Test;
+
+import static junit.framework.TestCase.assertFalse;
+import static junit.framework.TestCase.assertTrue;
+
+public class ScopingConventionsMockTest {
+    private boolean isTestByConventions(String path) {
+        for (Convention convention : new ScopingConventions().getTestFilesConventions()) {
+            if (convention.pathMatches(path)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    @Test
+    public void mockFoldersAreTestCode() {
+        assertTrue(isTestByConventions("x-pack/plugin/inference/qa/test-service-plugin/src/main/java/org/elasticsearch/xpack/inference/mock/Foo.java"));
+        assertTrue(isTestByConventions("/root/src/mock.data/a.json"));
+        assertTrue(isTestByConventions("/root/src/mock(old)/a.json"));
+        assertTrue(isTestByConventions("/root/src/mock-größe/a.json"));
+        assertTrue(isTestByConventions("/root/src/mock模拟/a.json"));
+        assertTrue(isTestByConventions("/root/src/__mock/a.json"));
+        assertTrue(isTestByConventions("C:\\root\\src\\mock\\a.json"));
+        assertTrue(isTestByConventions("C:\\root\\src\\mock.data\\a.json"));
+    }
+
+    @Test
+    public void previouslyMatchedMockFoldersStayTestCode() {
+        assertTrue(isTestByConventions("/root/src/mocks/a.js"));
+        assertTrue(isTestByConventions("/root/src/__mocks__/a.js"));
+        assertTrue(isTestByConventions("/root/src/mock-data/a.json"));
+        assertTrue(isTestByConventions("/root/src/mock_data/a.json"));
+        assertTrue(isTestByConventions("/root/src/mock data/a.json"));
+        assertTrue(isTestByConventions("/root/src/mockStore/a.js"));
+    }
+
+    @Test
+    public void matchStaysWithinFolderName() {
+        assertFalse(isTestByConventions("/root/src/remock/a.java"));
+        assertFalse(isTestByConventions("/root/src/demo/a.java"));
+        assertFalse(isTestByConventions("/root/src/main/java/a.java"));
+        assertFalse(isTestByConventions("/root/src/main/java/mock.java"));
+        assertFalse(isTestByConventions("/root/src/main/java/mockery.java"));
+    }
+}
