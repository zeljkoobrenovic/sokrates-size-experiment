+ */
+
+package nl.obren.sokrates.sourcecode.scoping;
+
+import org.junit.Test;
+
+import static junit.framework.TestCase.assertFalse;
+import static junit.framework.TestCase.assertTrue;
+
+public class ScopingConventionsMockTest {
+    private boolean isTestCode(String path) {
+        return new ScopingConventions().getTestFilesConventions().stream()
+                .anyMatch(convention -> convention.pathMatches(path));
+    }
+
+    @Test
+    public void testMockFoldersAreTestCode() {
+        assertTrue(isTestCode("/root/src/main/java/org/x/mock/Foo.java"));
+        assertTrue(isTestCode("/root/src/mock.data/Foo.java"));
+        assertTrue(isTestCode("/root/src/mock(old)/Foo.java"));
+        assertTrue(isTestCode("/root/src/mock-größe/Foo.java"));
+        assertTrue(isTestCode("/root/src/mock模拟/Foo.java"));
+        assertTrue(isTestCode("/root/src/mocks/Foo.java"));
+        assertTrue(isTestCode("/root/src/__mocks__/Foo.js"));
+        assertTrue(isTestCode("/root/src/mock-data/Foo.json"));
+        assertTrue(isTestCode("/root/src/mock_data/Foo.json"));
+        assertTrue(isTestCode("/root/src/mock data/Foo.json"));
+        assertTrue(isTestCode("/root/src/mockStore/Foo.js"));
+        assertTrue(isTestCode("\\root\\src\\mock\\Foo.java"));
+    }
+
+    @Test
+    public void testOtherFoldersAreNotTestCode() {
+        assertFalse(isTestCode("/root/src/remock/Foo.java"));
+        assertFalse(isTestCode("/root/src/demo/Foo.java"));
+        assertFalse(isTestCode("/root/src/main/java/Foo.java"));
+        assertFalse(isTestCode("/root/src/main/java/mock.java"));
+        assertFalse(isTestCode("/root/src/main/java/mockery.java"));
+    }
+}
