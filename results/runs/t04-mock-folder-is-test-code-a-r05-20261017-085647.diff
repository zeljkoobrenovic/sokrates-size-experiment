+
+package nl.obren.sokrates.sourcecode.scoping;
+
+import org.junit.Test;
+
+import static junit.framework.TestCase.assertFalse;
+import static junit.framework.TestCase.assertTrue;
+
+public class ScopingConventionsTest {
+    private final ScopingConventions conventions = new ScopingConventions();
+
+    private boolean isMockResources(String path) {
+        return conventions.getTestFilesConventions().stream()
+                .anyMatch(convention -> convention.pathMatches(path));
+    }
+
+    @Test
+    public void testMockFoldersAreTestCode() {
+        assertTrue(isMockResources("/src/main/java/org/example/mock/Service.java"));
+        assertTrue(isMockResources("/src/mock.data/Service.java"));
+        assertTrue(isMockResources("/src/mock(old)/Service.java"));
+        assertTrue(isMockResources("/src/mock-größe/Service.java"));
+        assertTrue(isMockResources("/src/mock模拟/Service.java"));
+        assertTrue(isMockResources("/src/__mock/Service.java"));
+        assertTrue(isMockResources("/src/__mocks__/Service.js"));
+        assertTrue(isMockResources("C:\\src\\mock\\Service.java"));
+        assertTrue(isMockResources("\\src\\mock.data\\Service.java"));
+    }
+
+    @Test
+    public void testPreviouslyMatchedMockFoldersAreStillTestCode() {
+        assertTrue(isMockResources("/src/mocks/Service.java"));
+        assertTrue(isMockResources("/src/__mocks__/Service.js"));
+        assertTrue(isMockResources("/src/mock-data/data.json"));
+        assertTrue(isMockResources("/src/mock_data/data.json"));
+        assertTrue(isMockResources("/src/mock data/data.json"));
+        assertTrue(isMockResources("/src/mockStore/store.js"));
+    }
+
+    @Test
+    public void testMatchStaysWithinFolderName() {
+        assertFalse(isMockResources("/src/remock/Service.java"));
+        assertFalse(isMockResources("/src/demo/Service.java"));
+        assertFalse(isMockResources("/src/main/java/Service.java"));
+        assertFalse(isMockResources("/src/main/java/mock.java"));
+        assertFalse(isMockResources("/src/main/java/mockery.java"));
+    }
+}
