+ */
+
+package nl.obren.sokrates.sourcecode.scoping;
+
+import org.junit.Test;
+
+import java.lang.reflect.Field;
+import java.util.List;
+
+import static junit.framework.TestCase.assertFalse;
+import static junit.framework.TestCase.assertTrue;
+
+public class ScopingConventionsTest {
+    @Test
+    public void testMockFoldersAreTestCode() throws Exception {
+        List<Convention> conventions = getTestFilesConventions();
+
+        String[] mockFolders = {
+                "a/mock/x.java", "a/mock.data/x.java", "a/mock(old)/x.java", "a/mock-größe/x.java", "a/mock模拟/x.java",
+                "a/mocks/x.java", "a/__mocks__/x.java", "a/mock-data/x.java", "a/mock_data/x.java", "a/mock data/x.java",
+                "a/mockStore/x.java", "a/__mock/x.java", "mock/x.java", "a\\mock\\x.java", "a\\mock.data\\x.java"
+        };
+        for (String path : mockFolders) {
+            assertTrue(path, matchesAny(conventions, path));
+        }
+
+        String[] notMock = {
+                "a/remock/x.java", "a/demo/x.java", "src/main/java/x.java", "a/mock.java", "a/mockery.java"
+        };
+        for (String path : notMock) {
+            assertFalse(path, matchesAny(conventions, path));
+        }
+    }
+
+    private boolean matchesAny(List<Convention> conventions, String path) {
+        return conventions.stream().anyMatch(convention -> convention.pathMatches(path));
+    }
+
+    @SuppressWarnings("unchecked")
+    private List<Convention> getTestFilesConventions() throws Exception {
+        Field field = ScopingConventions.class.getDeclaredField("testFilesConventions");
+        field.setAccessible(true);
+        return (List<Convention>) field.get(new ScopingConventions());
+    }
+}
