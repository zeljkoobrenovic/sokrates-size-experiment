+
+package nl.obren.sokrates.sourcecode.scoping;
+
+import org.junit.Test;
+
+import static junit.framework.TestCase.assertFalse;
+import static junit.framework.TestCase.assertTrue;
+
+public class ScopingConventionsTest {
+    private boolean isTestFile(String path) {
+        for (Convention convention : new ScopingConventions().getTestFilesConventions()) {
+            if (convention.pathMatches(path)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    @Test
+    public void testMockFoldersAreTestCode() {
+        assertTrue(isTestFile("/repo/x-pack/plugin/inference/qa/test-service-plugin/src/main/java/org/elasticsearch/xpack/inference/mock/Service.java"));
+        assertTrue(isTestFile("/repo/src/mock.data/a.json"));
+        assertTrue(isTestFile("/repo/src/mock(old)/a.json"));
+        assertTrue(isTestFile("/repo/src/mock-größe/a.json"));
+        assertTrue(isTestFile("/repo/src/mock模拟/a.json"));
+        assertTrue(isTestFile("/repo/src/mock/a.json"));
+        assertTrue(isTestFile("/repo/src/mocks/a.json"));
+        assertTrue(isTestFile("/repo/src/__mocks__/a.json"));
+        assertTrue(isTestFile("/repo/src/mock-data/a.json"));
+        assertTrue(isTestFile("/repo/src/mock_data/a.json"));
+        assertTrue(isTestFile("/repo/src/mock data/a.json"));
+        assertTrue(isTestFile("/repo/src/mockStore/a.json"));
+        assertTrue(isTestFile("\\repo\\src\\mock.data\\a.json"));
+        assertTrue(isTestFile("\\repo\\src\\mock\\a.json"));
+    }
+
+    @Test
+    public void testOnlyWholeMockFolderNamesAreTestCode() {
+        assertFalse(isTestFile("/repo/src/remock/a.java"));
+        assertFalse(isTestFile("/repo/src/demo/a.java"));
+        assertFalse(isTestFile("/repo/src/main/java/a.java"));
+        assertFalse(isTestFile("/repo/src/main/java/mock.java"));
+        assertFalse(isTestFile("/repo/src/main/java/mockery.java"));
+        assertFalse(isTestFile("\\repo\\src\\remock\\a.java"));
+    }
+}
