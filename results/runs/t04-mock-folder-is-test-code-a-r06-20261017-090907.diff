+
+package nl.obren.sokrates.sourcecode.scoping;
+
+import nl.obren.sokrates.sourcecode.SourceFileFilter;
+import org.junit.Test;
+
+import static junit.framework.TestCase.assertFalse;
+import static junit.framework.TestCase.assertTrue;
+
+public class ScopingConventionsMockTest {
+    private boolean isMockResources(String path) {
+        return new ScopingConventions().getTestFilesConventions().stream()
+                .filter(convention -> "Mock resources".equals(convention.getNote()))
+                .anyMatch(convention -> convention.pathMatches(path));
+    }
+
+    @Test
+    public void testMockFoldersAreTestCode() {
+        assertTrue(isMockResources("/root/x/mock/Foo.java"));
+        assertTrue(isMockResources("/root/x/mock.data/Foo.java"));
+        assertTrue(isMockResources("/root/x/mock(old)/Foo.java"));
+        assertTrue(isMockResources("/root/x/mock-größe/Foo.java"));
+        assertTrue(isMockResources("/root/x/mock模拟/Foo.java"));
+        assertTrue(isMockResources("\\root\\x\\mock\\Foo.java"));
+        assertTrue(isMockResources("/root/x/__mock/Foo.java"));
+        assertTrue(isMockResources("/root/x/mocks/Foo.java"));
+        assertTrue(isMockResources("/root/x/__mocks__/Foo.java"));
+        assertTrue(isMockResources("/root/x/mock-data/Foo.java"));
+        assertTrue(isMockResources("/root/x/mock_data/Foo.java"));
+        assertTrue(isMockResources("/root/x/mock data/Foo.java"));
+        assertTrue(isMockResources("/root/x/mockStore/Foo.java"));
+    }
+
+    @Test
+    public void testNonMockFoldersAreNotTestCode() {
+        assertFalse(isMockResources("/root/x/remock/Foo.java"));
+        assertFalse(isMockResources("/root/x/demo/Foo.java"));
+        assertFalse(isMockResources("/root/src/main/java/Foo.java"));
+        assertFalse(isMockResources("/root/src/main/java/mock.java"));
+        assertFalse(isMockResources("/root/src/main/java/mockery.java"));
+    }
+}
