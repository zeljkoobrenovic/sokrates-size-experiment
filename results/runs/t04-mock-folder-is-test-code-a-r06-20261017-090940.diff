+
+package nl.obren.sokrates.sourcecode.scoping;
+
+import org.junit.Test;
+
+import java.lang.reflect.Field;
+import java.util.List;
+
+import static junit.framework.TestCase.assertFalse;
+import static junit.framework.TestCase.assertTrue;
+
+public class ScopingConventionsTest {
+    @Test
+    public void testMockFoldersAreTestResources() throws Exception {
+        String[] mockPaths = {
+                "x-pack/plugin/inference/qa/test-service-plugin/src/main/java/org/elasticsearch/xpack/inference/mock/Service.java",
+                "src/mock.data/a.json",
+                "src/mock(old)/a.json",
+                "src/mock-größe/a.json",
+                "src/mock模拟/a.json",
+                "src/mock/a.json",
+                "src\\mock\\a.json",
+                "src/__mock/a.json",
+                "src/mocks/a.json",
+                "src/__mocks__/a.json",
+                "src/mock-data/a.json",
+                "src/mock_data/a.json",
+                "src/mock data/a.json",
+                "src/mockStore/a.json",
+        };
+
+        for (String path : mockPaths) {
+            assertTrue(path, isTestFile(path));
+        }
+
+        String[] nonMockPaths = {
+                "src/remock/a.java",
+                "src/demo/a.java",
+                "src/main/java/a.java",
+                "src/mock.java",
+                "src/mockery.java",
+        };
+
+        for (String path : nonMockPaths) {
+            assertFalse(path, isTestFile(path));
+        }
+    }
+
+    private boolean isTestFile(String path) throws Exception {
+        Field field = ScopingConventions.class.getDeclaredField("testFilesConventions");
+        field.setAccessible(true);
+        List<Convention> conventions = (List<Convention>) field.get(new ScopingConventions());
+        for (Convention convention : conventions) {
+            if (convention.pathMatches(path)) {
+                return true;
+            }
+        }
+        return false;
+    }
+}
