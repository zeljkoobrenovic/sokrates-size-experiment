+
+package nl.obren.sokrates.sourcecode.scoping;
+
+import org.junit.Test;
+
+import static junit.framework.TestCase.assertFalse;
+import static junit.framework.TestCase.assertTrue;
+
+public class ScopingConventionsTest {
+    private boolean isTestPath(String path) {
+        return new ScopingConventions().getTestFilesConventions().stream()
+                .anyMatch(convention -> convention.pathMatches(path));
+    }
+
+    @Test
+    public void mockFoldersAreTestResources() {
+        assertTrue(isTestPath("/root/src/mock/Foo.java"));
+        assertTrue(isTestPath("/root/src/mock.data/Foo.java"));
+        assertTrue(isTestPath("/root/src/mock(old)/Foo.java"));
+        assertTrue(isTestPath("/root/src/mock-größe/Foo.java"));
+        assertTrue(isTestPath("/root/src/mock模拟/Foo.java"));
+        assertTrue(isTestPath("/root/src/__mock/Foo.java"));
+        assertTrue(isTestPath("/root/src/__mock.x/Foo.java"));
+        assertTrue(isTestPath("\\root\\src\\mock\\Foo.java"));
+        assertTrue(isTestPath("\\root\\src\\mock.data\\Foo.java"));
+
+        assertTrue(isTestPath("/root/src/mocks/Foo.java"));
+        assertTrue(isTestPath("/root/src/__mocks__/Foo.java"));
+        assertTrue(isTestPath("/root/src/mock-data/Foo.java"));
+        assertTrue(isTestPath("/root/src/mock_data/Foo.java"));
+        assertTrue(isTestPath("/root/src/mock data/Foo.java"));
+        assertTrue(isTestPath("/root/src/mockStore/Foo.java"));
+    }
+
+    @Test
+    public void mockMatchesStayWithinFolderName() {
+        assertFalse(isTestPath("/root/src/remock/Foo.java"));
+        assertFalse(isTestPath("/root/src/demo/Foo.java"));
+        assertFalse(isTestPath("/root/src/main/java/Foo.java"));
+        assertFalse(isTestPath("/root/src/main/java/mock.java"));
+        assertFalse(isTestPath("/root/src/main/java/mockery.java"));
+    }
+}
