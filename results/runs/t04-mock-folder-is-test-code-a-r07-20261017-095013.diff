+ */
+
+package nl.obren.sokrates.sourcecode.scoping;
+
+import org.junit.Test;
+
+import static junit.framework.TestCase.assertFalse;
+import static junit.framework.TestCase.assertTrue;
+
+public class ScopingConventionsTest {
+    private boolean isTestFile(String path) {
+        return new ScopingConventions().getTestFilesConventions().stream()
+                .anyMatch(convention -> convention.pathMatches(path));
+    }
+
+    @Test
+    public void testMockFoldersAreTestCode() {
+        assertTrue(isTestFile("mock/Service.java"));
+        assertTrue(isTestFile("a/mock/Service.java"));
+        assertTrue(isTestFile("a/mock.data/Service.java"));
+        assertTrue(isTestFile("a/mock(old)/Service.java"));
+        assertTrue(isTestFile("a/mock-größe/Service.java"));
+        assertTrue(isTestFile("a/mock模拟/service.js"));
+        assertTrue(isTestFile("a\\mock\\Service.java"));
+
+        assertTrue(isTestFile("a/mocks/service.js"));
+        assertTrue(isTestFile("a/__mocks__/service.js"));
+        assertTrue(isTestFile("a/__mock/service.js"));
+        assertTrue(isTestFile("a/mock-data/service.json"));
+        assertTrue(isTestFile("a/mock_data/service.json"));
+        assertTrue(isTestFile("a/mock data/service.json"));
+        assertTrue(isTestFile("a/mockStore/service.ts"));
+    }
+
+    @Test
+    public void testMockMatchesStayWithinFolderName() {
+        assertFalse(isTestFile("a/remock/Service.java"));
+        assertFalse(isTestFile("a/demo/Service.java"));
+        assertFalse(isTestFile("src/main/java/Service.java"));
+        assertFalse(isTestFile("a/mock.java"));
+        assertFalse(isTestFile("a/mockery.java"));
+    }
+}
