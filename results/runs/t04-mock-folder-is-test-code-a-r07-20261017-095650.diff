+
+package nl.obren.sokrates.sourcecode.scoping;
+
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+public class ScopingConventionsMockTest {
+    private boolean isMockResources(String path) {
+        return new ScopingConventions().getTestFilesConventions().stream()
+                .filter(convention -> "Mock resources".equals(convention.getNote()))
+                .anyMatch(convention -> convention.pathMatches(path));
+    }
+
+    @Test
+    public void mockFolderNamesAreTestCode() {
+        assertTrue(isMockResources("/root/src/main/java/org/example/mock/Stub.java"));
+        assertTrue(isMockResources("/root/src/mock.data/Stub.java"));
+        assertTrue(isMockResources("/root/src/mock(old)/Stub.java"));
+        assertTrue(isMockResources("/root/src/mock-größe/Stub.java"));
+        assertTrue(isMockResources("/root/src/mock模拟/Stub.java"));
+        assertTrue(isMockResources("/root/src/__mock/Stub.java"));
+        assertTrue(isMockResources("/root/src/mocks/Stub.java"));
+        assertTrue(isMockResources("/root/src/__mocks__/Stub.java"));
+        assertTrue(isMockResources("/root/src/mock-data/Stub.java"));
+        assertTrue(isMockResources("/root/src/mock_data/Stub.java"));
+        assertTrue(isMockResources("/root/src/mock data/Stub.java"));
+        assertTrue(isMockResources("/root/src/mockStore/Stub.java"));
+        assertTrue(isMockResources("C:\\root\\src\\mock\\Stub.java"));
+        assertTrue(isMockResources("C:\\root\\src\\mock.data\\Stub.java"));
+    }
+
+    @Test
+    public void nonMockPathsAreNotTestCode() {
+        assertFalse(isMockResources("/root/src/remock/Stub.java"));
+        assertFalse(isMockResources("/root/src/demo/Stub.java"));
+        assertFalse(isMockResources("/root/src/main/java/Stub.java"));
+        assertFalse(isMockResources("/root/src/main/java/mock.java"));
+        assertFalse(isMockResources("/root/src/main/java/mockery.java"));
+        assertFalse(isMockResources("C:\\root\\src\\remock\\Stub.java"));
+    }
+}
