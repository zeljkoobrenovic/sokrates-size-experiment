+
+package nl.obren.sokrates.sourcecode.scoping;
+
+import nl.obren.sokrates.sourcecode.SourceFile;
+import nl.obren.sokrates.sourcecode.core.CodeConfiguration;
+import org.junit.Test;
+
+import java.io.File;
+import java.util.Collections;
+
+import static junit.framework.TestCase.assertFalse;
+import static junit.framework.TestCase.assertTrue;
+
+public class ScopingConventionsTest {
+    @Test
+    public void testMockFoldersAreTestCode() {
+        assertTrue(isTest("/root/src/mock/Service.java"));
+        assertTrue(isTest("/root/src/mock.data/Service.java"));
+        assertTrue(isTest("/root/src/mock(old)/Service.java"));
+        assertTrue(isTest("/root/src/mock-größe/Service.java"));
+        assertTrue(isTest("/root/src/mock模拟/Service.java"));
+        assertTrue(isTest("/root/src/mocks/Service.java"));
+        assertTrue(isTest("/root/src/__mocks__/Service.java"));
+        assertTrue(isTest("/root/src/mock-data/Service.java"));
+        assertTrue(isTest("/root/src/mock_data/Service.java"));
+        assertTrue(isTest("/root/src/mock data/Service.java"));
+        assertTrue(isTest("/root/src/mockStore/Service.java"));
+        assertTrue(isTest("\\root\\src\\mock\\Service.java"));
+    }
+
+    @Test
+    public void testMockMatchesStayWithinFolderName() {
+        assertFalse(isTest("/root/src/remock/Service.java"));
+        assertFalse(isTest("/root/src/demo/Service.java"));
+        assertFalse(isTest("/root/src/main/java/Service.java"));
+        assertFalse(isTest("/root/src/main/java/mock.java"));
+        assertFalse(isTest("/root/src/main/java/mockery.java"));
+    }
+
+    private boolean isTest(String path) {
+        CodeConfiguration codeConfiguration = new CodeConfiguration();
+        new ScopingConventions().addConventions(codeConfiguration,
+                Collections.singletonList(new SourceFile(new File(path))));
+        return !codeConfiguration.getTest().getSourceFileFilters().isEmpty();
+    }
+}
