+
+package nl.obren.sokrates.sourcecode.scoping;
+
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+public class ScopingConventionsMockTest {
+    private boolean isTestFile(String path) {
+        return new ScopingConventions().getTestFilesConventions().stream()
+                .anyMatch(convention -> convention.pathMatches(path));
+    }
+
+    @Test
+    public void mockFoldersAreTestCode() {
+        assertTrue(isTestFile("/src/x-pack/inference/mock/Foo.java"));
+        assertTrue(isTestFile("/src/mock.data/Foo.java"));
+        assertTrue(isTestFile("/src/mock(old)/Foo.java"));
+        assertTrue(isTestFile("/src/mock-größe/Foo.java"));
+        assertTrue(isTestFile("/src/mock模拟/Foo.java"));
+        assertTrue(isTestFile("/src/__mocks__/Foo.js"));
+        assertTrue(isTestFile("/src/__mock/Foo.js"));
+        assertTrue(isTestFile("/src/mocks/Foo.js"));
+        assertTrue(isTestFile("/src/mock-data/Foo.json"));
+        assertTrue(isTestFile("/src/mock_data/Foo.json"));
+        assertTrue(isTestFile("/src/mock data/Foo.json"));
+        assertTrue(isTestFile("/src/mockStore/Foo.js"));
+        assertTrue(isTestFile("C:\\src\\mock\\Foo.java"));
+        assertTrue(isTestFile("C:\\src\\mock.data\\Foo.java"));
+    }
+
+    @Test
+    public void otherNamesAreNotTestCode() {
+        assertFalse(isTestFile("/src/remock/Foo.java"));
+        assertFalse(isTestFile("/src/demo/Foo.java"));
+        assertFalse(isTestFile("/src/main/java/Foo.java"));
+        assertFalse(isTestFile("/src/mock.java"));
+        assertFalse(isTestFile("/src/mockery.java"));
+        assertFalse(isTestFile("C:\\src\\remock\\Foo.java"));
+    }
+}
