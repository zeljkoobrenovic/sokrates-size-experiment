+package nl.obren.sokrates.sourcecode.scoping;
+
+import org.junit.Test;
+
+import java.util.List;
+
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+public class ScopingConventionsMockTest {
+    private final List<Convention> testConventions = new ScopingConventions().getTestFilesConventions();
+
+    private boolean isTest(String path) {
+        return testConventions.stream().anyMatch(convention -> convention.pathMatches(path));
+    }
+
+    @Test
+    public void mockFoldersAreTestCode() {
+        String[] paths = {
+                "x-pack/plugin/inference/qa/test-service-plugin/src/main/java/org/elasticsearch/xpack/inference/mock/Service.java",
+                "src/mock.data/a.json",
+                "src/mock(old)/a.json",
+                "src/mock-größe/a.json",
+                "src/mock模拟/a.json",
+                "src/mocks/a.js",
+                "src/__mocks__/a.js",
+                "src/__mock/a.js",
+                "src/mock-data/a.json",
+                "src/mock_data/a.json",
+                "src/mock data/a.json",
+                "src/mockStore/a.js",
+                "C:\\project\\src\\mock.data\\a.json",
+                "C:\\project\\src\\mock\\a.json"
+        };
+        for (String path : paths) {
+            assertTrue(path, isTest(path));
+        }
+    }
+
+    @Test
+    public void otherFoldersAndFilesAreNotTestCode() {
+        String[] paths = {
+                "src/remock/a.java",
+                "src/demo/a.java",
+                "src/main/java/a.java",
+                "src/mock.java",
+                "src/mockery.java",
+                "C:\\project\\src\\remock\\a.java"
+        };
+        for (String path : paths) {
+            assertFalse(path, isTest(path));
+        }
+    }
+}
