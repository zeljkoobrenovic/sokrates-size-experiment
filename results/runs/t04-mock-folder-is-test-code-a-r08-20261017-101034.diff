+ */
+
+package nl.obren.sokrates.sourcecode.scoping;
+
+import org.junit.Test;
+
+import static junit.framework.TestCase.assertFalse;
+import static junit.framework.TestCase.assertTrue;
+
+public class ScopingConventionsTest {
+    private boolean isMockResource(String path) {
+        return new ScopingConventions().getTestFilesConventions().stream()
+                .filter(convention -> "Mock resources".equals(convention.getNote()))
+                .anyMatch(convention -> convention.pathMatches(path));
+    }
+
+    @Test
+    public void testMockFoldersAreTestResources() {
+        assertTrue(isMockResource("a/mock/File.java"));
+        assertTrue(isMockResource("a\\mock\\File.java"));
+        assertTrue(isMockResource("a/mock.data/File.json"));
+        assertTrue(isMockResource("a/mock(old)/File.json"));
+        assertTrue(isMockResource("a/mock-größe/File.json"));
+        assertTrue(isMockResource("a/mock模拟/File.json"));
+        assertTrue(isMockResource("a/__mock/File.json"));
+        assertTrue(isMockResource("a/__mocks__/File.js"));
+        assertTrue(isMockResource("a/mocks/File.js"));
+        assertTrue(isMockResource("a/mock-data/File.json"));
+        assertTrue(isMockResource("a/mock_data/File.json"));
+        assertTrue(isMockResource("a/mock data/File.json"));
+        assertTrue(isMockResource("a/mockStore/File.ts"));
+    }
+
+    @Test
+    public void testOnlyWholeMockFolderNamesAreTestResources() {
+        assertFalse(isMockResource("a/remock/File.java"));
+        assertFalse(isMockResource("a/demo/File.java"));
+        assertFalse(isMockResource("src/main/java/File.java"));
+        assertFalse(isMockResource("a/mock.java"));
+        assertFalse(isMockResource("a/mockery.java"));
+    }
+}
