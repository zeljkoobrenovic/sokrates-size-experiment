+
+package nl.obren.sokrates.sourcecode.scoping;
+
+import nl.obren.sokrates.sourcecode.SourceFileFilter;
+import org.junit.Test;
+
+import static junit.framework.TestCase.assertFalse;
+import static junit.framework.TestCase.assertTrue;
+
+public class ScopingConventionsTest {
+    private boolean isTestFile(String path) {
+        for (SourceFileFilter convention : new ScopingConventions().getTestFilesConventions()) {
+            if (convention.pathMatches(path)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    @Test
+    public void testMockFoldersAreTestCode() {
+        assertTrue(isTestFile("/root/x-pack/inference/mock/Service.java"));
+        assertTrue(isTestFile("/root/src/mock.data/Data.json"));
+        assertTrue(isTestFile("/root/src/mock(old)/Data.json"));
+        assertTrue(isTestFile("/root/src/mock-größe/Data.json"));
+        assertTrue(isTestFile("/root/src/mock模拟/Data.json"));
+        assertTrue(isTestFile("C:\\root\\src\\mock\\Data.java"));
+        assertTrue(isTestFile("C:\\root\\src\\mock.data\\Data.java"));
+
+        assertTrue(isTestFile("/root/src/mocks/Data.json"));
+        assertTrue(isTestFile("/root/src/__mocks__/Data.js"));
+        assertTrue(isTestFile("/root/src/mock-data/Data.json"));
+        assertTrue(isTestFile("/root/src/mock_data/Data.json"));
+        assertTrue(isTestFile("/root/src/mock data/Data.json"));
+        assertTrue(isTestFile("/root/src/mockStore/Data.js"));
+    }
+
+    @Test
+    public void testNonMockPathsAreNotTestCode() {
+        assertFalse(isTestFile("/root/src/remock/Data.java"));
+        assertFalse(isTestFile("/root/src/demo/Data.java"));
+        assertFalse(isTestFile("/root/src/main/java/Data.java"));
+        assertFalse(isTestFile("/root/src/main/java/mock.java"));
+        assertFalse(isTestFile("/root/src/main/java/mockery.java"));
+        assertFalse(isTestFile("C:\\root\\src\\remock\\Data.java"));
+    }
+}
