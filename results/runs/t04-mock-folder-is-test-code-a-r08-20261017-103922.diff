+
+package nl.obren.sokrates.sourcecode.scoping;
+
+import nl.obren.sokrates.sourcecode.SourceFile;
+import org.junit.Test;
+
+import java.io.File;
+
+import static junit.framework.TestCase.assertFalse;
+import static junit.framework.TestCase.assertTrue;
+
+public class ScopingConventionsTest {
+    private boolean isMockResources(String path) {
+        return new ScopingConventions().getTestFilesConventions().stream()
+                .anyMatch(convention -> convention.getNote().equals("Mock resources")
+                        && convention.matches(new SourceFile(new File(path))));
+    }
+
+    @Test
+    public void testMockFoldersAreTestCode() {
+        assertTrue(isMockResources("src/mock/Service.java"));
+        assertTrue(isMockResources("x/y/mock/Service.java"));
+        assertTrue(isMockResources("x/y/mock.data/Service.java"));
+        assertTrue(isMockResources("x/y/mock(old)/Service.java"));
+        assertTrue(isMockResources("x/y/mock-größe/Service.java"));
+        assertTrue(isMockResources("x/y/mock模拟/Service.java"));
+        assertTrue(isMockResources("x\\y\\mock\\Service.java"));
+        assertTrue(isMockResources("x/y/mocks/Service.java"));
+        assertTrue(isMockResources("x/y/__mocks__/Service.java"));
+        assertTrue(isMockResources("x/y/mock-data/Service.java"));
+        assertTrue(isMockResources("x/y/mock_data/Service.java"));
+        assertTrue(isMockResources("x/y/mock data/Service.java"));
+        assertTrue(isMockResources("x/y/mockStore/Service.java"));
+    }
+
+    @Test
+    public void testOtherFoldersAndFilesAreNotTestCode() {
+        assertFalse(isMockResources("x/y/remock/Service.java"));
+        assertFalse(isMockResources("x/y/demo/Service.java"));
+        assertFalse(isMockResources("src/main/java/Service.java"));
+        assertFalse(isMockResources("src/main/java/mock.java"));
+        assertFalse(isMockResources("src/main/java/mockery.java"));
+    }
+}
