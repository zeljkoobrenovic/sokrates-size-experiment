+
+package nl.obren.sokrates.sourcecode.scoping;
+
+import org.junit.Test;
+
+import static junit.framework.TestCase.assertFalse;
+import static junit.framework.TestCase.assertTrue;
+
+public class ScopingConventionsTest {
+    private boolean isMockResources(String path) {
+        return new ScopingConventions().getTestFilesConventions().stream()
+                .filter(convention -> "Mock resources".equals(convention.getNote()))
+                .anyMatch(convention -> convention.pathMatches(path));
+    }
+
+    @Test
+    public void testMockFoldersAreTestCode() {
+        assertTrue(isMockResources("x-pack/plugin/inference/qa/test-service-plugin/src/main/java/org/elasticsearch/xpack/inference/mock/Service.java"));
+        assertTrue(isMockResources("src/mock/a.java"));
+        assertTrue(isMockResources("mock/a.java"));
+        assertTrue(isMockResources("src/mock.data/a.json"));
+        assertTrue(isMockResources("src/mock(old)/a.json"));
+        assertTrue(isMockResources("src/mock-größe/a.json"));
+        assertTrue(isMockResources("src/mock模拟/a.json"));
+        assertTrue(isMockResources("src/mocks/a.js"));
+        assertTrue(isMockResources("src/__mocks__/a.js"));
+        assertTrue(isMockResources("src/mock-data/a.json"));
+        assertTrue(isMockResources("src/mock_data/a.json"));
+        assertTrue(isMockResources("src/mock data/a.json"));
+        assertTrue(isMockResources("src/mockStore/a.js"));
+        assertTrue(isMockResources("src/__mockData/a.js"));
+    }
+
+    @Test
+    public void testMockFoldersWithBackslashes() {
+        assertTrue(isMockResources("src\\main\\mock\\Service.java"));
+        assertTrue(isMockResources("src\\mock.data\\a.json"));
+        assertTrue(isMockResources("src\\mock-größe\\a.json"));
+    }
+
+    @Test
+    public void testNonMockPathsAreNotTestCode() {
+        assertFalse(isMockResources("src/remock/a.java"));
+        assertFalse(isMockResources("src/demo/a.java"));
+        assertFalse(isMockResources("src/main/java/a.java"));
+        assertFalse(isMockResources("src/main/java/mock.java"));
+        assertFalse(isMockResources("src/main/java/mockery.java"));
+        assertFalse(isMockResources("src/mock.java"));
+        assertFalse(isMockResources("src/mockery.java"));
+    }
+}
