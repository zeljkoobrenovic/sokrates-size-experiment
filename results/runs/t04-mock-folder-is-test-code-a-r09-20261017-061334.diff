+package nl.obren.sokrates.sourcecode.scoping;
+
+import nl.obren.sokrates.sourcecode.SourceFile;
+import org.junit.jupiter.api.Test;
+
+import java.io.File;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+public class MockFolderConventionTest {
+    private boolean isTest(String path) {
+        SourceFile file = new SourceFile(new File(path));
+        return new ScopingConventions().getTestFilesConventions().stream()
+                .anyMatch(c -> "Mock resources".equals(c.getNote()) && c.matches(file));
+    }
+
+    @Test
+    void mockFolders() {
+        String[] folders = {"mock", "mock.data", "mock(old)", "mock-größe", "mock模拟", "mocks", "__mocks__",
+                "mock-data", "mock_data", "mock data", "mockStore", "__mock"};
+        for (String f : folders) {
+            assertEquals(true, isTest("/a/src/" + f + "/X.java"), f);
+            assertEquals(true, isTest("C:\\a\\src\\" + f + "\\X.java"), f);
+        }
+        String[] others = {"/a/remock/X.java", "/a/demo/X.java", "/a/src/main/java/X.java",
+                "/a/mock.java", "/a/mockery.java"};
+        for (String p : others) {
+            assertEquals(false, isTest(p), p);
+        }
+    }
+}
