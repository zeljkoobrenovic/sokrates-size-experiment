+
+package nl.obren.sokrates.sourcecode.scoping;
+
+import org.junit.Test;
+
+import static junit.framework.TestCase.assertFalse;
+import static junit.framework.TestCase.assertTrue;
+
+public class ScopingConventionsTest {
+    private boolean isTestPath(String path) {
+        return new ScopingConventions().getTestFilesConventions().stream()
+                .anyMatch(convention -> convention.pathMatches(path));
+    }
+
+    @Test
+    public void testMockFoldersAreTestCode() {
+        assertTrue(isTestPath("/root/x-pack/inference/mock/A.java"));
+        assertTrue(isTestPath("/root/mock.data/a.json"));
+        assertTrue(isTestPath("/root/mock(old)/a.json"));
+        assertTrue(isTestPath("/root/mock-größe/a.txt"));
+        assertTrue(isTestPath("/root/mock模拟/a.txt"));
+        assertTrue(isTestPath("C:\\root\\mock\\A.java"));
+        assertTrue(isTestPath("C:\\root\\mock.data\\A.java"));
+
+        assertTrue(isTestPath("/root/mocks/a.java"));
+        assertTrue(isTestPath("/root/__mocks__/a.js"));
+        assertTrue(isTestPath("/root/__mock/a.js"));
+        assertTrue(isTestPath("/root/mock-data/a.json"));
+        assertTrue(isTestPath("/root/mock_data/a.json"));
+        assertTrue(isTestPath("/root/mock data/a.json"));
+        assertTrue(isTestPath("/root/mockStore/a.js"));
+    }
+
+    @Test
+    public void testMockMatchStaysWithinFolderName() {
+        assertFalse(isTestPath("/root/remock/a.java"));
+        assertFalse(isTestPath("/root/demo/a.java"));
+        assertFalse(isTestPath("/root/src/main/java/a.java"));
+        assertFalse(isTestPath("/root/mock.java"));
+        assertFalse(isTestPath("/root/mockery.java"));
+    }
+}
