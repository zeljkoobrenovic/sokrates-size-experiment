+
+package nl.obren.sokrates.sourcecode.scoping;
+
+import nl.obren.sokrates.sourcecode.SourceFileFilter;
+import org.junit.Test;
+
+import static junit.framework.TestCase.assertFalse;
+import static junit.framework.TestCase.assertTrue;
+
+public class ScopingConventionsTest {
+    private boolean isMockResource(String path) {
+        return new ScopingConventions().getTestFilesConventions().stream()
+                .filter(convention -> "Mock resources".equals(convention.getNote()))
+                .anyMatch(convention -> convention.pathMatches(path));
+    }
+
+    @Test
+    public void testMockFoldersAreTestCode() {
+        assertTrue(isMockResource("/src/mocks/a.js"));
+        assertTrue(isMockResource("/src/__mocks__/a.js"));
+        assertTrue(isMockResource("/src/mock-data/a.json"));
+        assertTrue(isMockResource("/src/mock_data/a.json"));
+        assertTrue(isMockResource("/src/mock data/a.json"));
+        assertTrue(isMockResource("/src/mockStore/a.js"));
+        assertTrue(isMockResource("/src/mockapi/a.js"));
+    }
+
+    @Test
+    public void testAnyMockFolderIsTestCode() {
+        assertTrue(isMockResource("/x-pack/plugin/inference/qa/test-service-plugin/src/main/java/org/elasticsearch/xpack/inference/mock/Service.java"));
+        assertTrue(isMockResource("/src/mock.data/a.json"));
+        assertTrue(isMockResource("/src/mock(old)/a.json"));
+        assertTrue(isMockResource("/src/mock-größe/a.json"));
+        assertTrue(isMockResource("/src/mock模拟/a.json"));
+        assertTrue(isMockResource("\\src\\mock\\a.java"));
+        assertTrue(isMockResource("C:\\src\\mock.data\\a.json"));
+    }
+
+    @Test
+    public void testMockMatchesStayWithinFolderName() {
+        assertFalse(isMockResource("/src/remock/a.java"));
+        assertFalse(isMockResource("/src/demo/a.java"));
+        assertFalse(isMockResource("/src/main/java/a.java"));
+        assertFalse(isMockResource("/src/mock.java"));
+        assertFalse(isMockResource("/src/mockery.java"));
+        assertFalse(isMockResource("/src/main/java/mock.java"));
+    }
+}
