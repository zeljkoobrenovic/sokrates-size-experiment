+        List<Convention> testConventions = new ScopingConventions().getTestFilesConventions();
+        String[] mockPaths = {
+                "/root/x-pack/inference/qa/src/main/java/org/mock/Foo.java",
+                "/root/src/mock.data/Foo.java",
+                "/root/src/mock(old)/Foo.java",
+                "/root/src/mock-größe/Foo.java",
+                "/root/src/mock模拟/Foo.java",
+                "/root/src/mocks/Foo.java",
+                "/root/src/__mocks__/Foo.java",
+                "/root/src/mock-data/Foo.java",
+                "/root/src/mockStore/Foo.java",
+                "C:\\root\\src\\mock\\Foo.java",
+        };
+        String[] nonMockPaths = {
+                "/root/src/remock/Foo.java",
+                "/root/src/demo/Foo.java",
+                "/root/src/main/java/Foo.java",
+                "/root/src/main/java/mock.java",
+                "/root/src/main/java/mockery.java",
+        };
+        for (String path : mockPaths) {
+            assertTrue(path, testConventions.stream().anyMatch(convention -> convention.pathMatches(path)));
+        }
+        for (String path : nonMockPaths) {
+            assertFalse(path, testConventions.stream().anyMatch(convention -> convention.pathMatches(path)));
+        }
+    }
