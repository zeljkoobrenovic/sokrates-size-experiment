+
+package nl.obren.sokrates.sourcecode.scoping;
+
+import nl.obren.sokrates.sourcecode.SourceFile;
+import nl.obren.sokrates.sourcecode.core.CodeConfiguration;
+import org.junit.Test;
+
+import java.io.File;
+import java.util.Arrays;
+import java.util.List;
+
+import static junit.framework.TestCase.assertEquals;
+
+public class ScopingConventionsTest {
+    @Test
+    public void mockFoldersAreTestCode() {
+        assertTestScope(
+                "x-pack/plugin/inference/qa/test-service-plugin/src/main/java/org/elasticsearch/xpack/inference/mock/Foo.java",
+                "src/mocks/Foo.java",
+                "src/__mocks__/Foo.java",
+                "src/__mock__/Foo.java",
+                "src/mock-data/Foo.java",
+                "src/mock_data/Foo.java",
+                "src/mock data/Foo.java",
+                "src/mockStore/Foo.java",
+                "src/mock.data/Foo.java",
+                "src/mock(old)/Foo.java",
+                "src/mock-größe/Foo.java",
+                "src/mock模拟/Foo.java",
+                "src\\main\\mock\\Foo.java",
+                "src\\mock.data\\Foo.java"
+        );
+    }
+
+    @Test
+    public void otherFoldersAreNotTestCode() {
+        assertNotTestScope(
+                "src/remock/Foo.java",
+                "src/demo/Foo.java",
+                "src/main/java/Foo.java",
+                "src/main/java/mock.java",
+                "src/main/java/mockery.java",
+                "src/main/java/Mock.java"
+        );
+    }
+
+    private void assertTestScope(String... paths) {
+        assertEquals(paths.length, countTestFiles(paths));
+    }
+
+    private void assertNotTestScope(String... paths) {
+        assertEquals(0, countTestFiles(paths));
+    }
+
+    private int countTestFiles(String... paths) {
+        List<SourceFile> sourceFiles = Arrays.stream(paths)
+                .map(path -> new SourceFile(new File(path), ""))
+                .collect(java.util.stream.Collectors.toList());
+        CodeConfiguration codeConfiguration = new CodeConfiguration();
+        new ScopingConventions().addConventions(codeConfiguration, sourceFiles);
+        return (int) sourceFiles.stream()
+                .filter(sourceFile -> codeConfiguration.getTest().getSourceFileFilters().stream()
+                        .anyMatch(filter -> filter.matches(sourceFile)))
+                .count();
+    }
+}
