+
+package nl.obren.sokrates.sourcecode.scoping;
+
+import org.junit.Test;
+
+import static junit.framework.TestCase.assertFalse;
+import static junit.framework.TestCase.assertTrue;
+
+public class ScopingConventionsMockFoldersTest {
+    private final ScopingConventions conventions = new ScopingConventions();
+
+    private boolean isTestCode(String path) {
+        return conventions.getTestFilesConventions().stream().anyMatch(convention -> convention.pathMatches(path));
+    }
+
+    @Test
+    public void mockFoldersAreTestCode() {
+        assertTrue(isTestCode("/root/qa/test-service-plugin/src/main/java/org/elasticsearch/xpack/inference/mock/Service.java"));
+        assertTrue(isTestCode("/root/src/mock.data/a.json"));
+        assertTrue(isTestCode("/root/src/mock(old)/a.json"));
+        assertTrue(isTestCode("/root/src/mock-größe/a.json"));
+        assertTrue(isTestCode("/root/src/mock模拟/a.json"));
+        assertTrue(isTestCode("/root/src/__mock/a.json"));
+        assertTrue(isTestCode("/root/src/mock/nested/a.json"));
+        assertTrue(isTestCode("\\root\\src\\mock\\a.java"));
+        assertTrue(isTestCode("\\root\\src\\mock.data\\a.java"));
+    }
+
+    @Test
+    public void previouslyClassifiedMockFoldersStayTestCode() {
+        assertTrue(isTestCode("/root/src/mocks/a.js"));
+        assertTrue(isTestCode("/root/src/__mocks__/a.js"));
+        assertTrue(isTestCode("/root/src/mock-data/a.json"));
+        assertTrue(isTestCode("/root/src/mock_data/a.json"));
+        assertTrue(isTestCode("/root/src/mock data/a.json"));
+        assertTrue(isTestCode("/root/src/mockStore/a.js"));
+    }
+
+    @Test
+    public void matchIsLimitedToTheFolderName() {
+        assertFalse(isTestCode("/root/src/remock/a.java"));
+        assertFalse(isTestCode("/root/src/demo/a.java"));
+        assertFalse(isTestCode("/root/src/main/java/a.java"));
+        assertFalse(isTestCode("/root/src/main/java/mock.java"));
+        assertFalse(isTestCode("/root/src/main/java/mockery.java"));
+    }
+}
