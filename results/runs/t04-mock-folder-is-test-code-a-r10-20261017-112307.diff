+
+package nl.obren.sokrates.sourcecode.scoping;
+
+import org.junit.Test;
+
+import static junit.framework.TestCase.assertFalse;
+import static junit.framework.TestCase.assertTrue;
+
+public class MockResourcesConventionTest {
+    private boolean isMockResources(String path) {
+        return new ScopingConventions().getTestFilesConventions().stream()
+                .filter(convention -> "Mock resources".equals(convention.getNote()))
+                .anyMatch(convention -> convention.pathMatches(path));
+    }
+
+    @Test
+    public void testFoldersStartingWithMockAreMockResources() {
+        assertTrue(isMockResources("/root/x-pack/inference/mock/Service.java"));
+        assertTrue(isMockResources("/root/src/mock.data/file.json"));
+        assertTrue(isMockResources("/root/src/mock(old)/file.json"));
+        assertTrue(isMockResources("/root/src/mock-größe/file.json"));
+        assertTrue(isMockResources("/root/src/mock模拟/file.json"));
+        assertTrue(isMockResources("/root/src/__mock/file.json"));
+        assertTrue(isMockResources("C:\\root\\src\\mock\\file.json"));
+    }
+
+    @Test
+    public void testExistingMockFoldersAreStillMockResources() {
+        assertTrue(isMockResources("/root/src/mocks/file.json"));
+        assertTrue(isMockResources("/root/src/__mocks__/file.js"));
+        assertTrue(isMockResources("/root/src/mock-data/file.json"));
+        assertTrue(isMockResources("/root/src/mock_data/file.json"));
+        assertTrue(isMockResources("/root/src/mock data/file.json"));
+        assertTrue(isMockResources("/root/src/mockStore/file.js"));
+    }
+
+    @Test
+    public void testOtherPathsAreNotMockResources() {
+        assertFalse(isMockResources("/root/src/remock/file.java"));
+        assertFalse(isMockResources("/root/src/demo/file.java"));
+        assertFalse(isMockResources("/root/src/main/java/Foo.java"));
+        assertFalse(isMockResources("/root/src/mock.java"));
+        assertFalse(isMockResources("/root/src/mockery.java"));
+    }
+}
