+ */
+
+package nl.obren.sokrates.sourcecode.scoping;
+
+import org.junit.Test;
+
+import static junit.framework.TestCase.assertFalse;
+import static junit.framework.TestCase.assertTrue;
+
+public class ScopingConventionsTest {
+    private final ScopingConventions conventions = new ScopingConventions();
+
+    private boolean isTestFile(String path) {
+        return conventions.getTestFilesConventions().stream().anyMatch(convention -> convention.pathMatches(path));
+    }
+
+    @Test
+    public void testMockFoldersAreTestCode() {
+        assertTrue(isTestFile("x-pack/plugin/inference/qa/test-service-plugin/src/main/java/org/elasticsearch/xpack/inference/mock/A.java"));
+        assertTrue(isTestFile("src/mock.data/A.java"));
+        assertTrue(isTestFile("src/mock(old)/A.java"));
+        assertTrue(isTestFile("src/mock-größe/A.java"));
+        assertTrue(isTestFile("src/mock模拟/A.java"));
+        assertTrue(isTestFile("src\\mock\\A.java"));
+        assertTrue(isTestFile("src\\mock.data\\A.java"));
+
+        assertTrue(isTestFile("src/mocks/A.java"));
+        assertTrue(isTestFile("src/__mocks__/A.js"));
+        assertTrue(isTestFile("src/__mock__/A.js"));
+        assertTrue(isTestFile("src/mock-data/A.json"));
+        assertTrue(isTestFile("src/mock_data/A.json"));
+        assertTrue(isTestFile("src/mock data/A.json"));
+        assertTrue(isTestFile("src/mockStore/A.js"));
+    }
+
+    @Test
+    public void testMockMatchStaysWithinFolderName() {
+        assertFalse(isTestFile("src/remock/A.java"));
+        assertFalse(isTestFile("src/demo/A.java"));
+        assertFalse(isTestFile("src/main/java/A.java"));
+        assertFalse(isTestFile("src/mock.java"));
+        assertFalse(isTestFile("src/mockery.java"));
+    }
+}
